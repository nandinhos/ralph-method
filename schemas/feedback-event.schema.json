{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralph-method.local/schemas/feedback-event.schema.json",
  "title": "Evento de feedback do loop Ralph",
  "description": "Fato operacional sanitizado emitido pelo loop para o orquestrador externo.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "event",
    "state",
    "health",
    "engine",
    "phase",
    "progress",
    "detail",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "timestamp": {"type": "string", "format": "date-time"},
    "event": {
      "enum": [
        "run_start",
        "phase_start",
        "cycle_start",
        "gate_fail",
        "phase_done",
        "phase_already_done",
        "phase_failed",
        "limit_wait",
        "run_end"
      ]
    },
    "state": {"enum": ["running", "waiting", "blocked", "completed", "failed"]},
    "health": {"enum": ["ok", "warning", "error"]},
    "engine": {"type": "string", "minLength": 1, "maxLength": 80},
    "phase": {
      "type": "object",
      "required": ["number", "total", "title", "attempt"],
      "properties": {
        "number": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "title": {"type": "string", "maxLength": 500},
        "attempt": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["percent"],
      "properties": {
        "percent": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "detail": {"type": "string", "maxLength": 2000},
    "source": {"const": "ralph"}
  },
  "additionalProperties": false
}
