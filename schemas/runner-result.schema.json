{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralph-method.local/schemas/runner-result.schema.json",
  "title": "Resultado normalizado de runner do Ralph Method",
  "type": "object",
  "required": [
    "schema_version", "runner", "runner_version", "requested_model",
    "identity_status", "identity_source", "execution_id", "execution_mode", "workflow_id", "feature_key", "attempt", "status",
    "exit_code", "fallback_used", "fallback_status", "events_seen", "session_id",
    "terminal_event", "error_summary", "artifact_refs"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "2.0.0"]},
    "runner": {"enum": ["opencode", "agy", "cursor", "codex", "claude"]},
    "runner_version": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "requested_model": {"type": ["string", "null"]},
    "effective_model": {"type": ["string", "null"]},
    "identity_status": {"enum": ["exact", "declared", "observed", "partial", "unavailable"]},
    "identity_source": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "pattern": "^exec_[A-Za-z0-9_-]+$"},
    "execution_mode": {"enum": ["impl", "verify"]},
    "workflow_id": {"type": "string", "pattern": "^wf_[A-Za-z0-9_-]+$"},
    "feature_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "attempt": {"type": "integer", "minimum": 0},
    "session_id": {"type": ["string", "null"]},
    "status": {"enum": ["completed", "failed", "interrupted", "usage_limited"]},
    "exit_code": {"type": "integer"},
    "fallback_used": {"type": ["boolean", "null"]},
    "fallback_status": {"enum": ["unknown", "detected", "not_detected"]},
    "events_seen": {"type": "integer", "minimum": 0},
    "event_bytes": {"type": "integer", "minimum": 0},
    "terminal_event": {"type": ["string", "null"]},
    "prompt_sha256": {"type": ["string", "null"]},
    "prompt_transport": {"type": ["string", "null"]},
    "permission_policy_hash": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "permission_policy_status": {"enum": ["verified", "not_required", "failed", "declared"]},
    "verification_agent": {"type": ["string", "null"]},
    "error_summary": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "profile": {"type": ["string", "null"]},
    "failure_domain": {"type": ["string", "null"]},
    "failure_domain_status": {"enum": ["exact", "observed", "declared", "unavailable"]},
    "failure_domain_source": {"type": ["string", "null"]},
    "reason_code": {"type": ["string", "null"]},
    "classification_confidence": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["high", "medium", "low", "unknown"]}
      ]
    },
    "classifier_source": {"type": ["string", "null"]},
    "retry_at": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      ]
    },
    "result_commit": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      ]
    },
    "result_tree_hash": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0.0"}}},
      "then": {
        "properties": {
          "runner": {"const": "opencode"},
          "profile": {"const": null},
          "failure_domain": {"const": null},
          "failure_domain_status": {"const": null},
          "failure_domain_source": {"const": null},
          "reason_code": {"const": null},
          "classification_confidence": {"const": null},
          "classifier_source": {"const": null},
          "retry_at": {"const": null},
          "result_commit": {"const": null},
          "result_tree_hash": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {
        "properties": {
          "runner": {"const": "agy"},
          "profile": {"const": null},
          "failure_domain": {"const": null},
          "failure_domain_status": {"const": null},
          "failure_domain_source": {"const": null},
          "reason_code": {"const": null},
          "classification_confidence": {"const": null},
          "classifier_source": {"const": null},
          "retry_at": {"const": null},
          "result_commit": {"const": null},
          "result_tree_hash": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}},
      "then": {
        "properties": {
          "runner": {"const": "cursor"},
          "profile": {"const": null},
          "failure_domain": {"const": null},
          "failure_domain_status": {"const": null},
          "failure_domain_source": {"const": null},
          "reason_code": {"const": null},
          "classification_confidence": {"const": null},
          "classifier_source": {"const": null},
          "retry_at": {"const": null},
          "result_commit": {"const": null},
          "result_tree_hash": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.0.0"}}},
      "then": {
        "required": ["profile", "failure_domain_status"],
        "properties": {
          "runner": {"enum": ["codex", "claude", "opencode"]},
          "profile": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {"failure_domain_status": {"enum": ["exact", "observed"]}},
              "required": ["failure_domain_status"]
            },
            "then": {
              "required": ["failure_domain", "failure_domain_source"],
              "properties": {
                "failure_domain": {"type": "string", "minLength": 1},
                "failure_domain_source": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "usage_limited"}}},
            "then": {
              "required": ["reason_code", "classification_confidence", "classifier_source", "retry_at"],
              "properties": {
                "reason_code": {"const": "provider_usage_limited"},
                "classification_confidence": {"const": "high"},
                "classifier_source": {"type": "string", "minLength": 1},
                "retry_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "required": ["session_id", "terminal_event"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "events_seen": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"runner": {"const": "opencode"}, "status": {"const": "completed"}},
        "required": ["runner", "status"]
      },
      "then": {"properties": {"terminal_event": {"const": "step_finish"}}}
    },
    {
      "if": {
        "properties": {"runner": {"const": "agy"}, "status": {"const": "completed"}},
        "required": ["runner", "status"]
      },
      "then": {"properties": {"terminal_event": {"const": "result"}}}
    },
    {
      "if": {
        "properties": {"runner": {"const": "cursor"}, "status": {"const": "completed"}},
        "required": ["runner", "status"]
      },
      "then": {"properties": {"terminal_event": {"const": "result"}}}
    },
    {
      "if": {
        "allOf": [
          {"properties": {"execution_mode": {"const": "verify"}}},
          {
            "not": {
              "allOf": [
                {"properties": {"schema_version": {"const": "1.2.0"}}},
                {"properties": {"runner": {"const": "cursor"}}}
              ]
            }
          }
        ]
      },
      "then": {
        "required": ["permission_policy_hash", "permission_policy_status", "verification_agent"],
        "properties": {
          "permission_policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "permission_policy_status": {"const": "verified"},
          "verification_agent": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"execution_mode": {"const": "verify"}}},
          {"properties": {"schema_version": {"const": "1.2.0"}}},
          {"properties": {"runner": {"const": "cursor"}}}
        ]
      },
      "then": {
        "required": ["permission_policy_status", "permission_policy_hash", "verification_agent"],
        "properties": {
          "permission_policy_status": {"const": "declared"},
          "permission_policy_hash": {"const": null},
          "verification_agent": {"const": "ask"}
        }
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "impl"}}},
      "then": {
        "required": ["permission_policy_hash", "permission_policy_status"],
        "properties": {
          "permission_policy_hash": {"type": "null"},
          "permission_policy_status": {"const": "not_required"}
        }
      }
    }
  ],
  "additionalProperties": false
}
