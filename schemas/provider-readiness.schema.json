{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralph-method.local/schemas/provider-readiness.schema.json",
  "title": "Prontidão de provider do Ralph Method",
  "type": "object",
  "required": ["providers", "verification"],
  "properties": {
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "verification": {
      "type": "object",
      "required": ["requested", "mode", "live_generation_probe"],
      "properties": {
        "requested": {"type": "boolean"},
        "mode": {"enum": ["none", "safe"]},
        "live_generation_probe": {"const": false}
      },
      "additionalProperties": false
    },
    "harness_signals": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "test_command": {"type": ["string", "null"]},
    "git": {
      "type": "object",
      "properties": {
        "commit": {"type": "string"},
        "branch": {"type": "string"},
        "working_tree_clean": {"type": "boolean"}
      },
      "required": ["commit", "branch", "working_tree_clean"],
      "additionalProperties": false
    },
    "context_files": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "installed",
        "path",
        "version",
        "auth_status",
        "health_status",
        "status",
        "adapter_enabled",
        "runner_supported",
        "capabilities",
        "verification",
        "reason"
      ],
      "properties": {
        "installed": {"type": "boolean"},
        "path": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "auth_status": {"enum": ["not_checked", "unknown", "authenticated", "unauthenticated"]},
        "health_status": {"enum": ["not_checked", "unsupported", "healthy", "unhealthy"]},
        "status": {"enum": ["unavailable", "detected", "authentication_unknown", "unauthenticated", "authenticated", "functional", "degraded", "unsupported"]},
        "adapter_enabled": {"type": "boolean"},
        "runner_supported": {"type": "boolean"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "verification": {
          "type": "object",
          "required": ["requested", "mode", "probe_kind", "checked_at"],
          "properties": {
            "requested": {"type": "boolean"},
            "mode": {"enum": ["none", "safe"]},
            "probe_kind": {"const": "diagnostic"},
            "checked_at": {"type": ["string", "null"], "format": "date-time"},
            "auth_exit": {"type": "integer"},
            "auth_timed_out": {"type": "boolean"},
            "provider_target": {"type": "string", "minLength": 1},
            "health_exit": {"type": "integer"},
            "health_timed_out": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
