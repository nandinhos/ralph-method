# Perfil self-hosted do Ralph Method via Antigravity CLI (agy); altere somente se quiser
# uma política local. Verify exige Linux, bwrap operacional e token OAuth local.
RALPH_BIN=scripts/ralph.sh
RALPH_AGY_MODEL=gemini-3.7-flash-high
RALPH_AGY_EFFORT=high
RALPH_AGY_AGENT=
RALPH_AGY_VERIFY_AGENT=ralph-review
RALPH_AGY_PRINT_TIMEOUT=30m
RALPH_VERIFY_MODEL=gemini-3.7-flash-high
RALPH_TEST_CMD=bash scripts/ci-portable.sh
