# Perfil self-hosted do Ralph Method via OpenCode; altere somente se quiser uma
# política local. A proof read-only é gerada fora da raiz mutável e não é
# versionada; gere antes do primeiro verify:
#   bash scripts/opencode-readonly-proof.sh \
#     --repo-root "$PWD" --agent ralph-review \
#     --model "$RALPH_OPENCODE_MODEL" \
#     --proof-file /tmp/ralph-readonly-policy-proof.json
RALPH_BIN=scripts/ralph.sh
RALPH_OPENCODE_MODEL=opencode/deepseek-v4-flash-free
RALPH_OPENCODE_VARIANT=
RALPH_OPENCODE_AGENT=ralph-review
RALPH_OPENCODE_AUTO=1
RALPH_OPENCODE_PURE=1
RALPH_OPENCODE_VERIFY_AGENT=ralph-review
RALPH_OPENCODE_VERIFY_POLICY_PROOF=/tmp/ralph-readonly-policy-proof.json
RALPH_VERIFY_MODEL=opencode/deepseek-v4-flash-free
RALPH_TEST_CMD=bash scripts/ci-portable.sh
