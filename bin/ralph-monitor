#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Monitor somente leitura do workflow do Ralph.
 *
 * Ele não aprova gates, não libera leases e não altera o ledger. Sua função é
 * tornar visível o progresso, publicar um snapshot consumível pelo supervisor
 * e apontar ausência de heartbeat ou de processo.
 */

/**
 * Versão do contrato publicado em schemas/monitor-snapshot.schema.json.
 * A UI só renderiza snapshots cuja major corresponde a esta constante.
 */
const MONITOR_SNAPSHOT_SCHEMA_VERSION = '1.0.0';

/** Gates obrigatórios da entrega, na ordem em que o método os cobra. */
const MONITOR_MANDATORY_GATES = ['validation', 'quality', 'runtime_evidence', 'technical_review', 'curation'];

/** Estados terminais de uma feature na projeção do controlador. */
const MONITOR_DONE_STATES = ['approved', 'released'];

/**
 * Subcomandos do controlador que apenas leem o ledger. Um processo destes
 * nunca é runner: contá-lo mascara `process_missing` quando a execução morre.
 */
const MONITOR_READONLY_COMMANDS = [
    'status', 'verify', 'provider-status', 'failover-plan',
    'trace-report', 'observe', 'document-id', 'document-index',
];

/** @return array<string, string|bool> */
function monitorArguments(array $argv): array
{
    $arguments = [];
    for ($index = 1; $index < count($argv); $index++) {
        $argument = $argv[$index];
        if (! str_starts_with($argument, '--')) {
            continue;
        }

        $argument = substr($argument, 2);
        if (str_contains($argument, '=')) {
            [$key, $value] = explode('=', $argument, 2);
            $arguments[$key] = $value;
            continue;
        }

        $next = $argv[$index + 1] ?? null;
        if ($next !== null && ! str_starts_with($next, '--')) {
            $arguments[$argument] = $next;
            $index++;
            continue;
        }

        $arguments[$argument] = true;
    }

    return $arguments;
}

/**
 * Coleta um parâmetro repetível (`--project a --project b`), que o parser
 * genérico sobrescreveria.
 *
 * @return list<string>
 */
function monitorRepeated(array $argv, string $name): array
{
    $values = [];
    for ($index = 1; $index < count($argv); $index++) {
        $argument = $argv[$index];
        if ($argument === '--'.$name) {
            $next = $argv[$index + 1] ?? null;
            if (is_string($next) && ! str_starts_with($next, '--')) {
                $values[] = $next;
                $index++;
            }
            continue;
        }
        if (str_starts_with($argument, '--'.$name.'=')) {
            $values[] = substr($argument, strlen($name) + 3);
        }
    }

    return $values;
}

/** @return array{exit: int, stdout: string, stderr: string} */
function monitorCommand(string $command, ?string $cwd = null): array
{
    $pipes = [];
    $process = proc_open($command, [
        0 => ['pipe', 'r'],
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ], $pipes, $cwd);

    if (! is_resource($process)) {
        return ['exit' => 1, 'stdout' => '', 'stderr' => 'não foi possível iniciar o comando'];
    }

    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    return ['exit' => proc_close($process), 'stdout' => $stdout, 'stderr' => $stderr];
}

function monitorRequired(array $arguments, string $name): string
{
    $value = $arguments[$name] ?? null;
    if (! is_string($value) || trim($value) === '') {
        fwrite(STDERR, "erro: parâmetro obrigatório ausente: --{$name}\n");
        exit(2);
    }

    return trim($value);
}

function monitorInt(array $arguments, string $name, int $default, int $minimum): int
{
    $value = $arguments[$name] ?? $default;
    if (is_bool($value) || ! is_numeric($value)) {
        fwrite(STDERR, "erro: --{$name} deve ser numérico\n");
        exit(2);
    }

    $value = (int) $value;
    if ($value < $minimum) {
        fwrite(STDERR, "erro: --{$name} deve ser maior ou igual a {$minimum}\n");
        exit(2);
    }

    return $value;
}

function monitorBool(array $arguments, string $name): bool
{
    return ($arguments[$name] ?? false) === true;
}

function monitorAge(?string $timestamp): ?int
{
    if ($timestamp === null || $timestamp === '') {
        return null;
    }

    try {
        $eventTime = new DateTimeImmutable($timestamp);
    } catch (Throwable) {
        return null;
    }

    return max(0, time() - $eventTime->getTimestamp());
}

function monitorFormatAge(?int $seconds): string
{
    if ($seconds === null) {
        return 'indisponível';
    }
    if ($seconds < 60) {
        return $seconds.'s';
    }
    if ($seconds < 3600) {
        return intdiv($seconds, 60).'min '.($seconds % 60).'s';
    }

    return intdiv($seconds, 3600).'h '.intdiv($seconds % 3600, 60).'min';
}

function monitorProgressBar(float|int $percent, int $width = 20): string
{
    $percent = max(0, min(100, (float) $percent));
    $filled = (int) round(($percent / 100) * $width);

    return '['.str_repeat('█', $filled).str_repeat('·', $width - $filled).']';
}

function monitorGitCommonDir(string $root): ?string
{
    $git = monitorCommand('git -C '.escapeshellarg($root).' rev-parse --git-common-dir');
    if ($git['exit'] !== 0) {
        return null;
    }

    $gitCommonDir = trim($git['stdout']);
    if (! str_starts_with($gitCommonDir, DIRECTORY_SEPARATOR)) {
        $gitCommonDir = $root.DIRECTORY_SEPARATOR.$gitCommonDir;
    }

    return realpath($gitCommonDir) ?: $gitCommonDir;
}

function monitorDefaultFeedbackFile(string $root): string
{
    return (monitorGitCommonDir($root) ?: $root).DIRECTORY_SEPARATOR.'ralph-control/monitor/latest.json';
}

function monitorLoopFeedbackFile(string $root): string
{
    return (monitorGitCommonDir($root) ?: $root).DIRECTORY_SEPARATOR.'ralph-control/feedback/events.jsonl';
}

/** @param array<string, mixed> $snapshot */
function monitorWriteFeedback(string $path, array $snapshot): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        return;
    }

    $temporary = $path.'.tmp.'.bin2hex(random_bytes(6));
    $json = json_encode($snapshot, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
    if (file_put_contents($temporary, $json, LOCK_EX) === false || ! rename($temporary, $path)) {
        @unlink($temporary);
    }
}

/**
 * Decide se a linha de comando pertence a um runner (executa trabalho) ou a um
 * observador (apenas lê). Sem essa separação o próprio monitor, o `status` que
 * ele dispara ou um `ralph-metrics` aberto em outro terminal contam como
 * execução viva e escondem um runner morto atrás de `health: ok`.
 */
function monitorIsRunnerProcess(string $command): bool
{
    if (preg_match('/ralph-monitor|ralph-metrics|ralph-trace|ralph-doctor/', $command) === 1) {
        return false;
    }
    if (preg_match('/ralph\.sh|ralph-block|ralph-bloco/', $command) === 1) {
        return true;
    }
    if (preg_match('/ralph-control\S*\s+(\S+)/', $command, $matches) !== 1) {
        return false;
    }

    return ! in_array($matches[1], MONITOR_READONLY_COMMANDS, true);
}

/** @return list<array{pid: int, age: int, command: string}> */
function monitorProcesses(string $workflowId): array
{
    $result = monitorCommand('ps -eo pid=,etimes=,cmd=');
    if ($result['exit'] !== 0) {
        return [];
    }

    $self = getmypid();
    $processes = [];
    foreach (preg_split('/\R/', $result['stdout']) ?: [] as $line) {
        if (! str_contains($line, $workflowId)) {
            continue;
        }
        if (preg_match('/^\s*(\d+)\s+(\d+)\s+(.+)$/', $line, $matches) !== 1) {
            continue;
        }
        $command = trim($matches[3]);
        if ((int) $matches[1] === $self || ! monitorIsRunnerProcess($command)) {
            continue;
        }

        $processes[] = [
            'pid' => (int) $matches[1],
            'age' => (int) $matches[2],
            'command' => $command,
        ];
    }

    return $processes;
}

/**
 * Descobre o workflow ativo do checkout sem exigir `--workflow`: o manifesto
 * local do control plane já declara qual é. Sem isso a UI não consegue abrir
 * um projeto que o operador não saiba nomear de cor.
 */
function monitorDiscoverWorkflowId(string $root): ?string
{
    $file = (monitorGitCommonDir($root) ?: $root).DIRECTORY_SEPARATOR.'ralph-control/workflow.json';
    if (! is_file($file)) {
        return null;
    }

    try {
        $workflow = json_decode((string) file_get_contents($file), true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable) {
        return null;
    }

    $workflowId = is_array($workflow) && is_string($workflow['workflow_id'] ?? null) ? $workflow['workflow_id'] : null;

    return $workflowId !== null && str_starts_with($workflowId, 'wf_') ? $workflowId : null;
}

/**
 * Lê o ledger uma única vez por snapshot e devolve, em ordem, os eventos do
 * workflow observado.
 *
 * @return list<array<string, mixed>>
 */
function monitorEvents(string $root, string $workflowId): array
{
    $gitCommonDir = monitorGitCommonDir($root);
    if ($gitCommonDir === null) {
        return [];
    }

    $eventsFile = $gitCommonDir.DIRECTORY_SEPARATOR.'ralph-control/events.jsonl';
    if (! is_file($eventsFile)) {
        return [];
    }

    $events = [];
    foreach (file($eventsFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        try {
            $event = json_decode($line, true, 512, JSON_THROW_ON_ERROR);
        } catch (Throwable) {
            continue;
        }
        if (is_array($event) && ($event['workflow_id'] ?? null) === $workflowId) {
            $events[] = $event;
        }
    }

    return $events;
}

/**
 * @param  list<array<string, mixed>>  $events
 * @return array<string, mixed>|null
 */
function monitorLastEvent(array $events, ?string $featureKey): ?array
{
    for ($index = count($events) - 1; $index >= 0; $index--) {
        if ($featureKey === null || ($events[$index]['feature_key'] ?? null) === $featureKey) {
            return $events[$index];
        }
    }

    return null;
}

/**
 * Timeline enxuta para a UI: campos declarados, nunca `facts` inteiro — os
 * fatos carregam caminhos, sessões e recortes de execução que não devem sair
 * do checkout por uma porta HTTP.
 *
 * @param  list<array<string, mixed>>  $events
 * @return list<array<string, mixed>>
 */
function monitorTimeline(array $events, int $limit): array
{
    $timeline = [];
    for ($index = count($events) - 1; $index >= 0 && count($timeline) < $limit; $index--) {
        $event = $events[$index];
        $facts = is_array($event['facts'] ?? null) ? $event['facts'] : [];
        $timeline[] = [
            'event_id' => is_string($event['event_id'] ?? null) ? $event['event_id'] : null,
            'type' => is_string($event['type'] ?? null) ? $event['type'] : null,
            'summary' => is_string($event['summary'] ?? null) ? $event['summary'] : null,
            'feature_key' => is_string($event['feature_key'] ?? null) ? $event['feature_key'] : null,
            'attempt' => is_int($event['attempt'] ?? null) ? $event['attempt'] : null,
            'timestamp' => is_string($event['timestamp'] ?? null) ? $event['timestamp'] : null,
            'age_seconds' => monitorAge(is_string($event['timestamp'] ?? null) ? $event['timestamp'] : null),
            'gate' => is_string($facts['gate'] ?? null) ? $facts['gate'] : null,
            'runner' => is_string($facts['runner'] ?? null) ? $facts['runner'] : null,
            'exit_code' => is_int($facts['exit_code'] ?? null) ? $facts['exit_code'] : null,
        ];
    }

    return $timeline;
}

/**
 * Runner corrente derivado do ledger. O snapshot antigo omitia isso, então a
 * UI não tinha como dizer qual provider está gastando o tempo da tentativa.
 *
 * @param  list<array<string, mixed>>  $events
 * @return array{name: ?string, provider: ?string, model: ?string, source: ?string}
 */
function monitorRunner(array $events, ?string $featureKey): array
{
    $empty = ['name' => null, 'provider' => null, 'model' => null, 'source' => null];
    for ($index = count($events) - 1; $index >= 0; $index--) {
        $event = $events[$index];
        if ($featureKey !== null && ($event['feature_key'] ?? null) !== $featureKey) {
            continue;
        }
        $type = is_string($event['type'] ?? null) ? $event['type'] : '';
        $facts = is_array($event['facts'] ?? null) ? $event['facts'] : [];
        if ($type === 'provider.failover_started' && is_string($facts['target_runner'] ?? null)) {
            return [
                'name' => $facts['target_runner'],
                'provider' => null,
                'model' => null,
                'source' => $type,
            ];
        }
        if (str_starts_with($type, 'delegation.') && is_string($facts['runner'] ?? null)) {
            return [
                'name' => $facts['runner'],
                'provider' => is_string($facts['provider'] ?? null) ? $facts['provider'] : null,
                'model' => is_string($facts['effective_model'] ?? null) ? $facts['effective_model'] : null,
                'source' => $type,
            ];
        }
    }

    return $empty;
}

/**
 * Achata a projeção em linhas de feature renderizáveis, sem vazar lease,
 * correlation_id ou fatos de execução.
 *
 * @param  list<mixed>  $features
 * @return list<array<string, mixed>>
 */
function monitorFeatureRows(array $features, ?string $cursor): array
{
    $rows = [];
    foreach ($features as $feature) {
        if (! is_array($feature)) {
            continue;
        }
        $featureKey = is_string($feature['feature_key'] ?? null) ? $feature['feature_key'] : null;
        $state = is_string($feature['state'] ?? null) ? $feature['state'] : 'pending';
        $rows[] = [
            'feature_key' => $featureKey,
            'position' => $feature['position'] ?? null,
            'title' => is_string($feature['title'] ?? null) ? $feature['title'] : null,
            'state' => $state,
            'knowledge_state' => is_string($feature['knowledge_state'] ?? null) ? $feature['knowledge_state'] : 'not_started',
            'attempt' => is_int($feature['attempt'] ?? null) ? $feature['attempt'] : 0,
            'done' => in_array($state, MONITOR_DONE_STATES, true),
            'current' => $featureKey !== null && $featureKey === $cursor,
            'gates' => monitorGateRows(is_array($feature['gates'] ?? null) ? $feature['gates'] : []),
        ];
    }

    return $rows;
}

/**
 * Gates obrigatórios nomeados, na ordem do método. O contador agregado não
 * distingue `rejected` de `harness_error` nem diz qual gate falta.
 *
 * @param  array<string, mixed>  $gates
 * @return list<array{gate: string, status: string}>
 */
function monitorGateRows(array $gates): array
{
    $rows = [];
    foreach (MONITOR_MANDATORY_GATES as $gate) {
        $status = $gates[$gate] ?? null;
        $rows[] = [
            'gate' => $gate,
            'status' => is_string($status) ? $status : 'pending',
        ];
    }

    return $rows;
}

/** @return array<string, mixed>|null */
function monitorLastLoopFeedback(string $root): ?array
{
    $path = monitorLoopFeedbackFile($root);
    if (! is_file($path)) {
        return null;
    }

    $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [];
    for ($index = count($lines) - 1; $index >= 0; $index--) {
        try {
            $event = json_decode($lines[$index], true, 512, JSON_THROW_ON_ERROR);
        } catch (Throwable) {
            continue;
        }
        if (is_array($event) && ($event['schema_version'] ?? null) === '1.0.0' && ($event['source'] ?? null) === 'ralph') {
            return $event;
        }
    }

    return null;
}

/**
 * Envelope de erro com a mesma identidade dos snapshots saudáveis: a UI precisa
 * saber de qual projeto o erro veio para não sumir com o cartão da lista.
 *
 * @return array<string, mixed>
 */
function monitorErrorSnapshot(string $root, string $workflowId, string $message): array
{
    return [
        'schema_version' => MONITOR_SNAPSHOT_SCHEMA_VERSION,
        'generated_at' => (new DateTimeImmutable)->format(DateTimeInterface::ATOM),
        'project' => ['path' => $root, 'name' => basename($root)],
        'health' => 'error',
        'workflow_id' => $workflowId,
        'message' => $message,
    ];
}

/** @return array<string, mixed> */
function monitorSnapshot(string $root, string $workflowId, int $staleAfter, int $activityStaleAfter, ?string $controllerPath = null, int $timelineLimit = 20): array
{
    $controller = realpath($controllerPath ?? $root.'/bin/ralph-control');
    if ($controller === false || ! is_executable($controller)) {
        return monitorErrorSnapshot($root, $workflowId, 'bin/ralph-control não encontrado ou não executável');
    }

    $command = escapeshellarg(PHP_BINARY).' '.escapeshellarg($controller)
        .' status --workflow '.escapeshellarg($workflowId);
    $status = monitorCommand($command, $root);
    if ($status['exit'] !== 0) {
        return monitorErrorSnapshot($root, $workflowId, trim($status['stderr'] !== '' ? $status['stderr'] : $status['stdout']));
    }

    try {
        $payload = json_decode($status['stdout'], true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $exception) {
        return monitorErrorSnapshot($root, $workflowId, 'status inválido: '.$exception->getMessage());
    }
    if (! is_array($payload)) {
        return monitorErrorSnapshot($root, $workflowId, 'status não retornou objeto JSON');
    }

    $projection = is_array($payload['projection'] ?? null) ? $payload['projection'] : [];
    $features = is_array($projection['features'] ?? null) ? $projection['features'] : [];
    $cursor = is_string($projection['cursor'] ?? null) ? $projection['cursor'] : null;
    $current = null;
    foreach ($features as $feature) {
        if (is_array($feature) && ($feature['feature_key'] ?? null) === $cursor) {
            $current = $feature;
            break;
        }
    }

    $events = monitorEvents($root, $workflowId);
    $lastEvent = monitorLastEvent($events, $cursor);
    $lastLoopFeedback = monitorLastLoopFeedback($root);
    $lastEventTimestamp = is_string($lastEvent['timestamp'] ?? null) ? $lastEvent['timestamp'] : null;
    $lastEventAge = monitorAge($lastEventTimestamp);
    $processes = monitorProcesses($workflowId);
    $lastFacts = is_array($lastEvent['facts'] ?? null) ? $lastEvent['facts'] : [];
    $lastProcessTree = is_array($lastFacts['process_tree'] ?? null) ? $lastFacts['process_tree'] : [];
    $idleSeconds = is_int($lastFacts['idle_seconds'] ?? null) ? $lastFacts['idle_seconds'] : null;
    $cpuMilli = is_int($lastProcessTree['cpu_milli'] ?? null) ? $lastProcessTree['cpu_milli'] : null;
    $state = is_array($current) && is_string($current['state'] ?? null) ? $current['state'] : 'complete';
    // `knowledge_*` vive em knowledge_state, nunca em state: mantê-los aqui
    // criava um ramo morto que nunca contava feature concluída alguma.
    $done = count(array_filter($features, static fn (mixed $feature): bool => is_array($feature) && in_array($feature['state'] ?? null, MONITOR_DONE_STATES, true)));
    $total = count($features);
    $mandatoryGates = MONITOR_MANDATORY_GATES;
    $passedGates = is_array($current) ? count(array_filter(
        $mandatoryGates,
        static fn (string $gate): bool => (($current['gates'][$gate] ?? null) === 'passed'),
    )) : 0;
    $featurePercent = $total > 0 ? round(($done / $total) * 100, 1) : 100.0;
    $gatePercent = round(($passedGates / count($mandatoryGates)) * 100, 1);
    $estimatedPercent = $total > 0
        ? round((($done + ($current === null ? 0 : $passedGates / count($mandatoryGates))) / $total) * 100, 1)
        : 100.0;

    $health = monitorHealth(
        $state,
        $processes,
        $lastEventAge,
        is_string($lastEvent['type'] ?? null) ? $lastEvent['type'] : null,
        $idleSeconds,
        $cpuMilli,
        $staleAfter,
        $activityStaleAfter,
    );

    return [
        'schema_version' => MONITOR_SNAPSHOT_SCHEMA_VERSION,
        'generated_at' => (new DateTimeImmutable)->format(DateTimeInterface::ATOM),
        'project' => ['path' => $root, 'name' => basename($root)],
        'health' => $health,
        'workflow_id' => $workflowId,
        'cursor' => $cursor,
        'state' => $state,
        'position' => is_array($current) ? ($current['position'] ?? null) : null,
        'title' => is_array($current) ? ($current['title'] ?? null) : null,
        'attempt' => is_array($current) ? ($current['attempt'] ?? null) : null,
        'total_features' => $total,
        'completed_features' => $done,
        'progress' => [
            'feature_percent' => $featurePercent,
            'gate_percent' => $gatePercent,
            'estimated_percent' => $estimatedPercent,
            'completed_features' => $done,
            'total_features' => $total,
            'passed_gates' => $passedGates,
            'total_gates' => count($mandatoryGates),
            'feature_bar' => monitorProgressBar($featurePercent),
            'gate_bar' => monitorProgressBar($gatePercent),
            'estimated_bar' => monitorProgressBar($estimatedPercent),
        ],
        'event_count' => $payload['event_count'] ?? null,
        'last_event' => [
            'type' => $lastEvent['type'] ?? null,
            'summary' => $lastEvent['summary'] ?? null,
            'timestamp' => $lastEventTimestamp,
            'age_seconds' => $lastEventAge,
            'idle_seconds' => $idleSeconds,
            'cpu_milli' => $cpuMilli,
        ],
        'loop_feedback' => $lastLoopFeedback,
        'processes' => $processes,
        'stale_after_seconds' => $staleAfter,
        'activity_stale_after_seconds' => $activityStaleAfter,
        // Projeção completa para quem renderiza: contadores respondem "quanto",
        // estas três respondem "o quê, onde e por quem".
        'features' => monitorFeatureRows($features, $cursor),
        'gates' => monitorGateRows(is_array($current['gates'] ?? null) ? $current['gates'] : []),
        'timeline' => monitorTimeline($events, $timelineLimit),
        'runner' => monitorRunner($events, $cursor),
        // FEATURE-094 (Phase 7): circuitos derivados do ledger, somente leitura.
        'provider_circuits' => (object) monitorProviderCircuits($events),
    ];
}

/**
 * Classifica a saúde a partir do estado projetado. Função pura de propósito:
 * a classificação é o que a UI e o supervisor consomem, e precisa ser
 * verificável sem ledger, processo vivo ou relógio real.
 *
 * @param  list<array{pid: int, age: int, command: string}>  $processes
 */
function monitorHealth(
    string $state,
    array $processes,
    ?int $lastEventAge,
    ?string $lastEventType,
    ?int $idleSeconds,
    ?int $cpuMilli,
    int $staleAfter,
    int $activityStaleAfter,
): string {
    return match (true) {
        $state === 'running' && $processes === [] => 'process_missing',
        $state === 'running' && $lastEventAge !== null && $lastEventAge > $staleAfter => 'heartbeat_stale',
        $state === 'running' && $lastEventType === 'command.heartbeat' && $idleSeconds !== null && $idleSeconds > $activityStaleAfter && ($cpuMilli ?? 0) <= 1000 => 'activity_stale',
        $state === 'awaiting_gates' && $lastEventAge !== null && $lastEventAge > $staleAfter => 'gates_stale',
        // Sem estes dois ramos um workflow parado esperando capacidade caía no
        // `default` e era publicado como `ok`.
        $state === 'capacity_wait' => 'capacity_wait',
        $state === 'provider_failover_pending' => 'provider_failover',
        in_array($state, ['debugging_required', 'debugging_running', 'debugging_verified'], true) => 'debugging',
        in_array($state, ['blocked', 'recovery_required'], true) => 'blocked',
        $state === 'complete' => 'complete',
        default => 'ok',
    };
}

/**
 * Deriva os circuitos `closed|open|half_open` por runner do ledger
 * (FEATURE-094). Apenas observação; não possui autoridade de transição.
 *
 * @param  list<array<string, mixed>>  $events
 * @return array<string, array{state: string, retry_at: ?string, domain: ?string}>
 */
function monitorProviderCircuits(array $events): array
{
    $circuits = [];
    $now = time();
    foreach ($events as $event) {
        if (($event['type'] ?? null) !== 'provider.capacity_limited') {
            continue;
        }
        $facts = is_array($event['facts'] ?? null) ? $event['facts'] : [];
        $runner = is_string($facts['runner'] ?? null) ? $facts['runner'] : 'unknown';
        $retryAt = is_string($facts['retry_at'] ?? null) ? $facts['retry_at'] : null;
        $retryEpoch = is_int($facts['retry_at_epoch'] ?? null) ? $facts['retry_at_epoch'] : null;
        $state = $retryEpoch !== null && $now >= $retryEpoch ? 'half_open' : 'open';
        $circuits[$runner] = [
            'state' => $state,
            'retry_at' => $retryAt,
            'domain' => is_string($facts['failure_domain'] ?? null) ? $facts['failure_domain'] : null,
        ];
    }
    ksort($circuits, SORT_STRING);

    return $circuits;
}

/** @param array<string, mixed> $snapshot */
function monitorFeedback(array $snapshot): string
{
    $health = (string) ($snapshot['health'] ?? 'error');
    $level = match ($health) {
        'ok' => 'INFO',
        'complete' => 'OK',
        'blocked', 'process_missing', 'heartbeat_stale', 'activity_stale', 'gates_stale', 'capacity_wait' => 'ALERTA',
        'debugging', 'provider_failover' => 'INFO',
        default => 'ERRO',
    };
    $feature = ($snapshot['cursor'] ?? null) ?: 'nenhuma';
    $state = (string) ($snapshot['state'] ?? 'desconhecido');
    $progress = (string) ($snapshot['completed_features'] ?? 0).'/'.(string) ($snapshot['total_features'] ?? 0);
    $progressData = is_array($snapshot['progress'] ?? null) ? $snapshot['progress'] : [];
    $estimated = (string) ($progressData['estimated_percent'] ?? 0).'%';
    $gates = (string) ($progressData['passed_gates'] ?? 0).'/'.(string) ($progressData['total_gates'] ?? 5);
    $estimatedBar = (string) ($progressData['estimated_bar'] ?? monitorProgressBar((float) ($progressData['estimated_percent'] ?? 0)));
    $last = is_array($snapshot['last_event'] ?? null) ? $snapshot['last_event'] : [];
    $processCount = is_array($snapshot['processes'] ?? null) ? count($snapshot['processes']) : 0;
    $message = match ($health) {
        'process_missing' => 'feature em execução, mas nenhum processo Ralph foi encontrado',
        'heartbeat_stale' => 'processo existe, mas não há novo evento há '.monitorFormatAge($last['age_seconds'] ?? null),
        'activity_stale' => 'heartbeat existe, mas não há saída/CPU observável há '.monitorFormatAge($last['idle_seconds'] ?? null),
        'gates_stale' => 'aguardando gates há '.monitorFormatAge($last['age_seconds'] ?? null),
        'blocked' => 'workflow bloqueado; recovery explícito necessário',
        'debugging' => match ($state) {
            'debugging_required' => 'falha entregue ao systematic debugging; o controlador precisa analisar antes de repetir',
            'debugging_running' => 'systematic debugging em andamento; a árvore está sob observação read-only',
            'debugging_verified' => 'causa raiz verificada; o controlador pode abrir nova tentativa',
            default => 'systematic debugging em andamento',
        },
        'capacity_wait' => 'execução parada aguardando capacidade do provider; nenhum runner trabalha agora',
        'provider_failover' => 'limite de uso confirmado; o controlador decide o próximo runner',
        'complete' => 'workflow concluído',
        'error' => (string) ($snapshot['message'] ?? 'falha ao consultar o workflow'),
        default => 'execução acompanhada normalmente',
    };
    $loopFeedback = is_array($snapshot['loop_feedback'] ?? null) ? $snapshot['loop_feedback'] : null;
    $loopSummary = $loopFeedback === null
        ? 'loop sem feedback'
        : (string) ($loopFeedback['event'] ?? 'evento desconhecido').': '.trim((string) preg_replace('/\s+/', ' ', (string) ($loopFeedback['detail'] ?? '')));

    return sprintf(
        '[%s] [%s] Ralph %s | feature=%s | estado=%s | progresso=%s | estimativa=%s %s | gates=%s | processos=%d | último evento=%s há %s | loop=%s | %s',
        (new DateTimeImmutable)->format('Y-m-d H:i:s'),
        $level,
        $snapshot['workflow_id'] ?? 'sem-workflow',
        $feature,
        $state,
        $progress,
        $estimated,
        $estimatedBar,
        $gates,
        $processCount,
        $last['type'] ?? 'indisponível',
        monitorFormatAge($last['age_seconds'] ?? null),
        $loopSummary,
        $message,
    );
}

function monitorSleep(int $seconds): void
{
    for ($remaining = $seconds; $remaining > 0; $remaining--) {
        sleep(1);
    }
}

/**
 * Resolve o workflow observado: o parâmetro explícito continua vencendo, mas a
 * ausência dele deixa de ser erro quando o checkout já declara um.
 */
function monitorResolveWorkflowId(array $arguments, string $root): string
{
    $explicit = $arguments['workflow'] ?? null;
    if (is_string($explicit) && trim($explicit) !== '') {
        return trim($explicit);
    }

    $discovered = monitorDiscoverWorkflowId($root);
    if ($discovered !== null) {
        return $discovered;
    }

    fwrite(STDERR, "erro: --workflow ausente e nenhum workflow declarado em ralph-control/workflow.json\n");
    exit(2);
}

/**
 * Coleta um snapshot por projeto. Um projeto ilegível vira cartão de erro em
 * vez de derrubar o painel inteiro.
 *
 * @param  list<string>  $projects
 * @return list<array<string, mixed>>
 */
function monitorProjectSnapshots(array $projects, int $staleAfter, int $activityStaleAfter, ?string $controllerPath): array
{
    $snapshots = [];
    foreach ($projects as $project) {
        $root = realpath($project);
        if ($root === false || ! is_dir($root)) {
            $snapshots[] = monitorErrorSnapshot($project, 'desconhecido', 'checkout não encontrado');
            continue;
        }
        $workflowId = monitorDiscoverWorkflowId($root);
        if ($workflowId === null) {
            $snapshots[] = monitorErrorSnapshot($root, 'desconhecido', 'nenhum workflow instalado neste checkout');
            continue;
        }
        $snapshots[] = monitorSnapshot($root, $workflowId, $staleAfter, $activityStaleAfter, $controllerPath);
    }

    return $snapshots;
}

/** @param array<string, mixed>|list<mixed> $payload */
function monitorHttpJson($socket, int $status, array|string $payload): void
{
    $body = is_string($payload)
        ? $payload
        : json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    monitorHttpWrite($socket, $status, 'application/json; charset=utf-8', $body);
}

function monitorHttpWrite($socket, int $status, string $contentType, string $body): void
{
    $reason = match ($status) {
        200 => 'OK',
        404 => 'Not Found',
        405 => 'Method Not Allowed',
        default => 'Internal Server Error',
    };
    $headers = "HTTP/1.1 {$status} {$reason}\r\n"
        ."Content-Type: {$contentType}\r\n"
        .'Content-Length: '.strlen($body)."\r\n"
        ."Cache-Control: no-store\r\n"
        ."Connection: close\r\n\r\n";
    fwrite($socket, $headers.$body);
}

/**
 * Servidor local somente leitura do painel. Ele não expõe nenhuma rota de
 * escrita: aprovar gate, liberar lease e iniciar feature continuam sendo
 * autoridade exclusiva do `ralph-control` na linha de comando.
 *
 * @param  list<string>  $projects
 */
function monitorServe(string $host, int $port, array $projects, int $staleAfter, int $activityStaleAfter, ?string $controllerPath): int
{
    $server = @stream_socket_server("tcp://{$host}:{$port}", $errorCode, $errorMessage);
    if ($server === false) {
        fwrite(STDERR, "erro: não foi possível abrir {$host}:{$port} ({$errorMessage})\n");

        return 2;
    }

    fwrite(STDOUT, sprintf(
        "painel somente leitura em http://%s:%d (%d projeto(s)); Ctrl+C encerra\n",
        $host,
        $port,
        count($projects),
    ));
    fflush(STDOUT);

    while (true) {
        $socket = @stream_socket_accept($server, -1);
        if ($socket === false) {
            continue;
        }
        stream_set_timeout($socket, 5);
        $request = (string) fgets($socket, 8192);
        while (($line = fgets($socket, 8192)) !== false && trim($line) !== '') {
            // Descarta cabeçalhos: nenhuma rota depende deles.
        }
        if (preg_match('#^(GET|HEAD) (\S+) HTTP/1\.[01]#', $request, $matches) !== 1) {
            monitorHttpJson($socket, 405, ['error' => 'apenas GET']);
            fclose($socket);
            continue;
        }

        $path = parse_url($matches[2], PHP_URL_PATH) ?: '/';
        if ($path === '/' || $path === '/index.html') {
            monitorHttpWrite($socket, 200, 'text/html; charset=utf-8', monitorUiDocument());
        } elseif ($path === '/api/projects') {
            monitorHttpJson($socket, 200, [
                'schema_version' => MONITOR_SNAPSHOT_SCHEMA_VERSION,
                'generated_at' => (new DateTimeImmutable)->format(DateTimeInterface::ATOM),
                'projects' => monitorProjectSnapshots($projects, $staleAfter, $activityStaleAfter, $controllerPath),
            ]);
        } else {
            monitorHttpJson($socket, 404, ['error' => 'rota inexistente']);
        }
        fclose($socket);
    }
}

