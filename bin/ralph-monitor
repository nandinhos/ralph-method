<script>
const HEALTH = {
  ok: ['ok', 'info', 'execução acompanhada normalmente'],
  complete: ['concluído', 'ok', 'workflow concluído'],
  process_missing: ['sem processo', 'bad', 'feature em execução, mas nenhum runner vivo foi encontrado'],
  heartbeat_stale: ['heartbeat parado', 'bad', 'o processo existe, mas o ledger não recebe eventos'],
  activity_stale: ['sem atividade', 'warn', 'há heartbeat, mas não há saída nem CPU observável'],
  gates_stale: ['gates parados', 'warn', 'aguardando gates além do limite'],
  capacity_wait: ['espera de capacidade', 'warn', 'execução parada aguardando capacidade do provider'],
  provider_failover: ['failover', 'info', 'limite de uso confirmado; o controlador decide o próximo runner'],
  debugging: ['debugging', 'info', 'systematic debugging em andamento'],
  blocked: ['bloqueado', 'bad', 'recovery explícito necessário'],
  error: ['erro', 'bad', 'não foi possível ler este projeto'],
};
const GATE_TONE = { passed: 'ok', rejected: 'bad', harness_error: 'warn', pending: 'idle' };
let projects = [];
let selected = 0;

const el = (tag, className, text) => {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
};
const chip = (health) => {
  const [label, tone] = HEALTH[health] || [health || 'desconhecido', 'idle'];
  return el('span', 'chip ' + tone, label);
};
const age = (seconds) => {
  if (seconds === null || seconds === undefined) return 'indisponível';
  if (seconds < 60) return seconds + 's';
  if (seconds < 3600) return Math.floor(seconds / 60) + 'min';
  return Math.floor(seconds / 3600) + 'h ' + Math.floor((seconds % 3600) / 60) + 'min';
};

function renderProjects() {
  const list = document.getElementById('projects');
  list.replaceChildren();
  projects.forEach((snapshot, index) => {
    const button = el('button', 'project');
    button.type = 'button';
    button.setAttribute('aria-current', String(index === selected));
    const head = el('div', 'project-name', (snapshot.project && snapshot.project.name) || 'projeto');
    button.append(head, chip(snapshot.health), el('div', 'project-path', (snapshot.project && snapshot.project.path) || ''));
    button.addEventListener('click', () => { selected = index; render(); });
    list.append(button);
  });
  if (!projects.length) list.append(el('p', 'empty', 'nenhum projeto informado em --project'));
}

function metric(label, value, note) {
  const card = el('div', 'card');
  card.append(el('div', 'metric-label', label), el('div', 'metric-value', value));
  if (note) card.append(el('div', 'row-title', note));
  return card;
}

function progress(label, percent) {
  const card = el('div', 'card');
  const track = el('div', 'track');
  const bar = el('div', 'bar');
  bar.style.width = Math.max(0, Math.min(100, percent || 0)) + '%';
  track.append(bar);
  card.append(el('div', 'metric-label', label), el('div', 'metric-value', (percent || 0) + '%'), track);
  return card;
}

function renderDetail() {
  const detail = document.getElementById('detail');
  detail.replaceChildren();
  const snapshot = projects[selected];
  if (!snapshot) {
    detail.append(el('p', 'empty', 'selecione um projeto'));
    return;
  }

  const [, , description] = HEALTH[snapshot.health] || ['', '', ''];
  const banner = el('div', 'card banner');
  const left = el('div');
  left.append(el('div', 'row-key', snapshot.workflow_id || 'sem workflow'));
  left.append(el('div', 'metric-value', snapshot.cursor || 'nenhuma feature em curso'));
  left.append(el('p', null, snapshot.message || description));
  banner.append(left, chip(snapshot.health));
  detail.append(banner);

  if (snapshot.health === 'error') return;

  const p = snapshot.progress || {};
  const metrics = el('div', 'metrics');
  metrics.append(
    progress('estimativa', p.estimated_percent),
    metric('features', (p.completed_features || 0) + '/' + (p.total_features || 0), 'estado atual: ' + (snapshot.state || '—')),
    metric('gates', (p.passed_gates || 0) + '/' + (p.total_gates || 5), 'tentativa ' + (snapshot.attempt ?? 0)),
    metric('runners vivos', String((snapshot.processes || []).length), (snapshot.runner && snapshot.runner.name) || 'runner não declarado'),
  );
  detail.append(metrics);

  const columns = el('div', 'columns');

  const gates = el('div', 'card');
  gates.append(el('h2', null, 'Gates da feature atual'));
  const gateRows = el('div', 'rows');
  (snapshot.gates || []).forEach((gate) => {
    const row = el('div', 'row');
    row.append(el('span', 'row-key', gate.gate), el('span', 'chip ' + (GATE_TONE[gate.status] || 'idle'), gate.status));
    gateRows.append(row);
  });
  gates.append(gateRows);

  const timeline = el('div', 'card');
  timeline.append(el('h2', null, 'Últimos eventos do ledger'));
  const events = el('div');
  (snapshot.timeline || []).forEach((event) => {
    const item = el('div', 'event');
    item.append(el('div', 'event-type', event.type || '—'));
    if (event.summary) item.append(el('div', 'row-title', event.summary));
    item.append(el('div', 'event-meta', [event.feature_key, 'tentativa ' + (event.attempt ?? 0), 'há ' + age(event.age_seconds)].filter(Boolean).join(' · ')));
    events.append(item);
  });
  if (!(snapshot.timeline || []).length) events.append(el('p', 'empty', 'ledger sem eventos para este workflow'));
  timeline.append(events);
  columns.append(gates, timeline);
  detail.append(columns);

  const features = el('div', 'card');
  features.append(el('h2', null, 'Features do workflow'));
  const rows = el('div', 'rows');
  (snapshot.features || []).forEach((feature) => {
    const row = el('div', 'row' + (feature.current ? ' current' : ''));
    const left = el('div');
    left.append(el('div', 'row-key', feature.feature_key || '—'));
    if (feature.title) left.append(el('div', 'row-title', feature.title));
    const right = el('div', 'banner');
    right.append(el('span', 'chip ' + (feature.done ? 'ok' : feature.current ? 'info' : 'idle'), feature.state));
    row.append(left, right);
    rows.append(row);
  });
  if (!(snapshot.features || []).length) rows.append(el('p', 'empty', 'workflow sem features'));
  features.append(rows);
  detail.append(features);

  const circuits = Object.entries(snapshot.provider_circuits || {});
  if (circuits.length) {
    const card = el('div', 'card');
    card.append(el('h2', null, 'Circuitos de provider'));
    const rows = el('div', 'rows');
    circuits.forEach(([runner, circuit]) => {
      const row = el('div', 'row');
      row.append(el('span', 'row-key', runner), el('span', 'chip ' + (circuit.state === 'open' ? 'bad' : 'warn'), circuit.state + (circuit.retry_at ? ' · retry ' + circuit.retry_at : '')));
      rows.append(row);
    });
    card.append(rows);
    detail.append(card);
  }
}

function render() {
  renderProjects();
  renderDetail();
}

async function refresh() {
  const meta = document.getElementById('meta');
  try {
    const response = await fetch('/api/projects', { cache: 'no-store' });
    const payload = await response.json();
    projects = payload.projects || [];
    if (selected >= projects.length) selected = 0;
    meta.textContent = 'contrato ' + payload.schema_version + ' · atualizado ' + new Date().toLocaleTimeString('pt-BR');
    render();
  } catch (error) {
    meta.textContent = 'falha ao consultar o monitor: ' + error.message;
  }
}

refresh();
window.setInterval(refresh, 10000);
</script>
</body>
</html>
HTML;
}

// A regressão carrega este arquivo como biblioteca para exercitar as funções
// puras (saúde, gates, classificação de processo) sem subir um workflow.
if (defined('RALPH_MONITOR_LIBRARY')) {
    return;
}

$arguments = monitorArguments($argv);
$subcommand = ($argv[1] ?? '');
$root = realpath((string) ($arguments['root'] ?? getcwd()));
$interval = monitorInt($arguments, 'interval', 30, 1);
$staleAfter = monitorInt($arguments, 'stale-after', max(180, $interval * 3), $interval);
$activityStaleAfter = monitorInt($arguments, 'activity-stale-after', max(900, $staleAfter * 5), $interval);
$once = monitorBool($arguments, 'once');
$asJson = monitorBool($arguments, 'json');
$controllerPath = is_string($arguments['controller'] ?? null) && trim((string) $arguments['controller']) !== ''
    ? trim((string) $arguments['controller'])
    : null;

if ($root === false || ! is_dir($root)) {
    fwrite(STDERR, "erro: raiz do checkout não encontrada\n");
    exit(2);
}

if ($subcommand === 'serve') {
    $projects = monitorRepeated($argv, 'project');
    if ($projects === []) {
        $projects = [$root];
    }
    $host = is_string($arguments['host'] ?? null) && trim((string) $arguments['host']) !== ''
        ? trim((string) $arguments['host'])
        : '127.0.0.1';

    exit(monitorServe(
        $host,
        monitorInt($arguments, 'port', 7777, 1),
        $projects,
        $staleAfter,
        $activityStaleAfter,
        $controllerPath,
    ));
}

$workflowId = monitorResolveWorkflowId($arguments, $root);
$feedbackFile = is_string($arguments['feedback-file'] ?? null) && trim((string) $arguments['feedback-file']) !== ''
    ? trim((string) $arguments['feedback-file'])
    : monitorDefaultFeedbackFile($root);

do {
    $snapshot = monitorSnapshot($root, $workflowId, $staleAfter, $activityStaleAfter, $controllerPath);
    monitorWriteFeedback($feedbackFile, $snapshot);
    if ($asJson) {
        fwrite(STDOUT, json_encode($snapshot, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n");
    } else {
        fwrite(STDOUT, monitorFeedback($snapshot)."\n");
    }
    fflush(STDOUT);

    if ($once || ($snapshot['health'] ?? null) === 'complete') {
        break;
    }
    monitorSleep($interval);
} while (true);
