        'adapters/agy/policy.php', 'adapters/agy/contract.md',
        '.agents/agents/ralph-review/agent.md',
        'adapters/cursor/runner.sh', 'adapters/cursor/parser.php', 'adapters/cursor/contract.md',
    ];
}

/** @return list<string> */
function generatedPaths(): array
{
    return ['.ralph/method.json', '.ralph/providers.json', '.ralph/codex.env', '.ralph/claude.env', '.ralph/opencode.env', '.ralph/agy.env', '.ralph/cursor.env'];
}

/** @return array<string, string> */
function generatedProfiles(): array
{
    return [
        '.ralph/codex.env' => "# Gerado pelo Ralph Method; altere somente se quiser uma política local.\nRALPH_BIN=scripts/ralph.sh\nRALPH_VERIFY_MODEL=gpt-5.6-luna\n",
        '.ralph/claude.env' => "# Gerado pelo Ralph Method; altere somente se quiser uma política local.\nRALPH_BIN=scripts/ralph.sh\nRALPH_VERIFY_MODEL=sonnet\n",
        '.ralph/opencode.env' => "# Gerado pelo Ralph Method; defina um modelo e uma prova read-only externa antes de executar.\nRALPH_BIN=scripts/ralph.sh\nRALPH_OPENCODE_MODEL=\nRALPH_OPENCODE_VARIANT=\nRALPH_OPENCODE_AGENT=\nRALPH_OPENCODE_AUTO=1\nRALPH_OPENCODE_PURE=1\nRALPH_OPENCODE_VERIFY_AGENT=ralph-review\nRALPH_OPENCODE_VERIFY_POLICY_PROOF=\nRALPH_VERIFY_MODEL=\n",
        '.ralph/agy.env' => "# Gerado pelo Ralph Method; verify exige Linux, bwrap e token OAuth local do agy.\nRALPH_BIN=scripts/ralph.sh\nRALPH_AGY_MODEL=\nRALPH_AGY_EFFORT=high\nRALPH_AGY_AGENT=\nRALPH_AGY_VERIFY_AGENT=ralph-review\nRALPH_AGY_PRINT_TIMEOUT=30m\nRALPH_VERIFY_MODEL=\n",
        '.ralph/cursor.env' => "# Gerado pelo Ralph Method. Cursor e IDE com LLM embutido: auth e a sessao local da conta (sem API key). Defina o modelo explicitamente.\nRALPH_BIN=scripts/ralph.sh\nRALPH_CURSOR_MODEL=\nRALPH_CURSOR_TIMEOUT=1800\nRALPH_CURSOR_VERIFY_MODE=ask\nRALPH_VERIFY_MODEL=\n",
    ];
}

function writeText(string $path, string $content): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        fail("não foi possível criar {$directory}");
    }
    if (file_put_contents($path, $content, LOCK_EX) === false) {
        fail("não foi possível escrever {$path}");
    }
}

function writeTextStrict(string $path, string $content): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        throw new RuntimeException("não foi possível criar {$directory}");
    }
    if (file_put_contents($path, $content, LOCK_EX) === false) {
        throw new RuntimeException("não foi possível escrever {$path}");
    }
}

function stageCopy(string $source, string $destination): void
{
    $directory = dirname($destination);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        throw new RuntimeException("não foi possível criar {$directory}");
    }
    if (! copy($source, $destination)) {
        throw new RuntimeException("não foi possível preparar {$destination}");
    }
    chmod($destination, ((int) fileperms($source) & 0111) !== 0 ? 0755 : 0644);
}

function removeTree(string $path): void
{
    if (is_link($path) || is_file($path)) {
        @unlink($path);
        return;
    }
    if (! is_dir($path)) {
        return;
    }
    foreach (scandir($path) ?: [] as $entry) {
        if (in_array($entry, ['.', '..'], true)) {
            continue;
        }
        removeTree($path.'/'.$entry);
    }
    @rmdir($path);
}

/** @param list<string> $paths */
function commitStagedFiles(string $root, string $stage, string $backup, array $paths): void
{
    $backedUp = [];
    $installed = [];
    try {
        foreach ($paths as $relative) {
            $destination = $root.'/'.$relative;
            $staged = $stage.'/'.$relative;
            $backupPath = $backup.'/'.$relative;
            if (is_file($destination)) {
                $backupDirectory = dirname($backupPath);
                if (! is_dir($backupDirectory) && ! mkdir($backupDirectory, 0700, true) && ! is_dir($backupDirectory)) {
                    throw new RuntimeException("não foi possível preparar backup de {$relative}");
                }
                if (! rename($destination, $backupPath)) {
                    throw new RuntimeException("não foi possível proteger {$relative} antes da instalação");
                }
                $backedUp[] = $relative;
            }
            $destinationDirectory = dirname($destination);
            if (! is_dir($destinationDirectory) && ! mkdir($destinationDirectory, 0700, true) && ! is_dir($destinationDirectory)) {
                throw new RuntimeException("não foi possível criar {$destinationDirectory}");
            }
            if (! rename($staged, $destination)) {
                throw new RuntimeException("não foi possível publicar {$relative}");
            }
            $installed[] = $relative;
        }
    } catch (Throwable $exception) {
        foreach (array_reverse($installed) as $relative) {
            @unlink($root.'/'.$relative);
        }
        foreach (array_reverse($backedUp) as $relative) {
            $destination = $root.'/'.$relative;
            $directory = dirname($destination);
            if (! is_dir($directory)) {
                @mkdir($directory, 0700, true);
            }
            @rename($backup.'/'.$relative, $destination);
        }
        throw $exception;
    }
}

/** @return array<string, mixed> */
function readManifest(string $path, ?string $expectedRoot = null): array
{
    $manifest = parseManifest($path, $expectedRoot);
    if ($manifest === null) {
        fail(is_file($path) ? 'manifesto de instalação inválido ou incompatível' : "manifesto de instalação não encontrado: {$path}", 2);
    }

    return $manifest;
}

/** @return array<string, mixed>|null */
function parseManifest(string $path, ?string $expectedRoot = null): ?array
{
    if (! is_file($path)) {
        return null;
    }
    try {
        $manifest = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    } catch (JsonException) {
        return null;
    }
    if (! is_array($manifest)
        || ($manifest['schema_version'] ?? null) !== RALPH_INSTALL_SCHEMA_VERSION
        || ! is_string($manifest['method_version'] ?? null)
        || ! is_string($manifest['installed_at'] ?? null)
        || ! is_array($manifest['project'] ?? null)
        || ! is_array($manifest['orchestration'] ?? null)
        || ! is_array($manifest['components'] ?? null)
        || ! in_array('installer', $manifest['components'], true)
        || ! is_array($manifest['managed_files'] ?? null)) {
        return null;
    }
    if ($expectedRoot !== null && ($manifest['project']['root'] ?? null) !== $expectedRoot) {
        return null;
    }

    return $manifest;
}

/** @return array<string, mixed> */
function installationPlan(string $root, array $detected, ?string $provider, string $requestedProvider): array
{
    global $sourceRoot;
    $manifestPath = $root.'/.ralph/install-manifest.json';
    $existing = parseManifest($manifestPath, $root);
    $ralphInstallation = detectExistingRalphInstallation($root, $existing);
    $files = [];
    foreach (array_merge(managedSources(), generatedPaths()) as $relative) {
        $source = $sourceRoot.'/'.$relative;
        $destination = $root.'/'.$relative;
        $currentHash = hashFile($destination);
        $ownedHash = null;
        foreach (($existing['managed_files'] ?? []) as $managed) {
            if (($managed['path'] ?? null) === $relative) {
                $ownedHash = $managed['installed_hash'] ?? null;
                break;
            }
        }
        $action = $currentHash === null ? 'create' : (($ownedHash !== null && $currentHash === $ownedHash) ? 'update' : 'conflict');
        $files[] = [
            'path' => $relative,
            'action' => $action,
            'current_hash' => $currentHash,
            'source_hash' => is_file($source) ? hashFile($source) : null,
            'generated' => ! in_array($relative, managedSources(), true),
        ];
    }

    return [
        'schema_version' => RALPH_INSTALL_SCHEMA_VERSION,
        'method_version' => RALPH_METHOD_VERSION,
        'project' => ['root' => $root, 'git' => $detected['git']],
        'selection' => [
            'requested_provider' => $requestedProvider,
            'selected_provider' => $provider,
            'selected_status' => $provider === null ? null : ($detected['providers'][$provider]['status'] ?? 'unavailable'),
            'adapter_enabled' => providerAdapterEnabled($detected, $provider),
            'functional_providers' => providersWithStatus($detected, 'functional'),
            'available_runners' => availableRunners($detected),
        ],
        'orchestration' => [
            'mode' => providerAdapterEnabled($detected, $provider)
                ? ($provider === 'codex' ? 'native_codex' : 'single_provider')
                : 'needs_review',
            'primary_runner' => $provider,
            'fallback_policy' => 'none',
        ],
        'detection' => $detected,
        'ralph_installation' => $ralphInstallation,
        'files' => $files,
        'existing_installation' => $existing !== null,
    ];
}

function printPlan(array $plan): void
{
    echo json_encode($plan, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
}

function externalSignalsApproved(array $external, array $allowedPaths): bool
{
    if (($external['status'] ?? null) === 'not_found') {
        return true;
    }
    if ($allowedPaths === [] || ! is_array($external['signals'] ?? null)) {
        return false;
    }
    $allowed = array_fill_keys(array_map('strval', $allowedPaths), true);
    foreach ($external['signals'] as $signal) {
        if (! is_array($signal) || ! isset($allowed[(string) ($signal['path'] ?? '')])) {
            return false;
        }
    }

    return $external['signals'] !== [];
}

function installationFailure(string $message, int $code, bool $throwErrors): never
{
    if ($throwErrors) {
        throw new RuntimeException($message);
    }

    fail($message, $code);
}

/** @return array<string, mixed> */
function installMethod(string $root, array $plan, $existingLock = null, array $allowedExternalPaths = [], bool $throwErrors = false): array
{
    global $sourceRoot;
    $ralphInstallation = $plan['ralph_installation']['external'] ?? [];
    if (($ralphInstallation['apply_allowed'] ?? false) !== true
        && ! externalSignalsApproved($ralphInstallation, $allowedExternalPaths)) {
        $status = (string) ($ralphInstallation['status'] ?? 'unknown');
        $reason = (string) ($ralphInstallation['reason'] ?? 'a origem existente não foi classificada');
        installationFailure("apply bloqueado: instalação Ralph {$status} fora do Ralph Method ({$reason}); preserve-a e faça uma migração explícita quando houver adapter compatível", 3, $throwErrors);
    }
    foreach ($plan['files'] as $file) {
        if ($file['action'] === 'conflict') {
            installationFailure('instalação interrompida por conflito em '.$file['path'], 3, $throwErrors);
        }
    }
    if (($plan['selection']['requested_provider'] ?? 'auto') !== 'auto' && ! ($plan['selection']['adapter_enabled'] ?? false)) {
        $provider = $plan['selection']['selected_provider'] ?? 'desconhecido';
        installationFailure("provider {$provider} não está apto; use --verify-providers e corrija autenticação/diagnóstico antes de habilitar o adapter", 3, $throwErrors);
    }
    $provider = $plan['orchestration']['primary_runner'];
    $ownsLock = false;
    $lock = $existingLock;
    if (! is_resource($lock)) {
        $lockPath = $root.'/.ralph/install.lock';
        if (! is_dir(dirname($lockPath)) && ! mkdir(dirname($lockPath), 0700, true) && ! is_dir(dirname($lockPath))) {
            installationFailure('não foi possível preparar o lock da instalação', 4, $throwErrors);
        }
        $lock = fopen($lockPath, 'c+');
        if ($lock === false || ! flock($lock, LOCK_EX | LOCK_NB)) {
            if (is_resource($lock)) {
                fclose($lock);
            }
            installationFailure('já existe uma instalação ou remoção em andamento', 4, $throwErrors);
        }
        $ownsLock = true;
    }

    // Revalida depois do lock: entre o plan e o apply outro processo pode ter
    // criado um marcador externo. O bloqueio precisa continuar fail-closed.
    $currentManifest = parseManifest($root.'/.ralph/install-manifest.json', $root);
    $currentInstallation = detectExistingRalphInstallation($root, $currentManifest);
    if (($currentInstallation['external']['apply_allowed'] ?? false) !== true
        && ! externalSignalsApproved($currentInstallation['external'] ?? [], $allowedExternalPaths)) {
        $status = (string) ($currentInstallation['external']['status'] ?? 'unknown');
        $reason = (string) ($currentInstallation['external']['reason'] ?? 'a origem existente não foi classificada');
        if ($ownsLock) {
            flock($lock, LOCK_UN);
            fclose($lock);
        }
        installationFailure("apply bloqueado após revalidação: instalação Ralph {$status} fora do Ralph Method ({$reason})", 3, $throwErrors);
    }

    $stage = $root.'/.ralph/.install-stage-'.bin2hex(random_bytes(6));
    $backup = $root.'/.ralph/.install-backup-'.bin2hex(random_bytes(6));
    $sourceFiles = array_values(array_filter($plan['files'], static fn (array $file): bool => ($file['generated'] ?? false) === false));
    $managedFiles = $plan['files'];
    $method = [
        'schema_version' => RALPH_INSTALL_SCHEMA_VERSION,
        'method_version' => RALPH_METHOD_VERSION,
        'orchestration' => $plan['orchestration'],
        'project' => $plan['project'],
        'test_command' => $plan['detection']['test_command'],
        'providers' => $plan['detection']['providers'],
    ];
    $providers = $plan['detection'];

    try {
        if (! mkdir($stage, 0700, true) && ! is_dir($stage)) {
            throw new RuntimeException('não foi possível criar o staging da instalação');
        }
        foreach ($sourceFiles as $file) {
            stageCopy($sourceRoot.'/'.$file['path'], $stage.'/'.$file['path']);
        }
        writeJsonStrict($stage.'/.ralph/method.json', $method);
        writeJsonStrict($stage.'/.ralph/providers.json', $providers);
        foreach (generatedProfiles() as $relative => $content) {
            writeTextStrict($stage.'/'.$relative, $content);
            chmod($stage.'/'.$relative, 0644);
        }

        $managed = [];
        foreach ($managedFiles as $file) {
            $relative = (string) $file['path'];
            $managed[] = [
                'path' => $relative,
                'source_hash' => $file['source_hash'] ?? null,
                'installed_hash' => hashFile($stage.'/'.$relative),
            ];
        }
        $manifest = [
            'schema_version' => RALPH_INSTALL_SCHEMA_VERSION,
            'method_version' => RALPH_METHOD_VERSION,
            'installed_at' => gmdate('Y-m-d\\TH:i:s\\Z'),
            'project' => $plan['project'],
            'orchestration' => $plan['orchestration'],
            'components' => ['installer', 'control_plane', 'trace', 'monitor', 'metrics', 'loop', 'hook', 'feedback', 'provider_readiness'],
            'managed_files' => $managed,
        ];
        writeJsonStrict($stage.'/.ralph/install-manifest.json', $manifest);

        $commitPaths = array_merge(array_map(static fn (array $file): string => (string) $file['path'], $managedFiles), ['.ralph/install-manifest.json']);
        commitStagedFiles($root, $stage, $backup, $commitPaths);
        removeTree($backup);
        removeTree($stage);
        if ($ownsLock) {
            flock($lock, LOCK_UN);
            fclose($lock);
        }

        return ['status' => 'installed', 'method_version' => RALPH_METHOD_VERSION, 'provider' => $provider, 'manifest' => '.ralph/install-manifest.json'];
    } catch (Throwable $exception) {
        removeTree($stage);
        removeTree($backup);
        if ($ownsLock) {
            flock($lock, LOCK_UN);
            fclose($lock);
        }
        installationFailure('instalação transacional revertida: '.$exception->getMessage(), 4, $throwErrors);
    }
}

function applyInstallation(string $root, array $plan): void
{
    printPlan(installMethod($root, $plan));
}

/** @return resource */
function openInstallationLock(string $root)
{
    $lockPath = $root.'/.ralph/install.lock';
    if (! is_dir(dirname($lockPath)) && ! mkdir(dirname($lockPath), 0700, true) && ! is_dir(dirname($lockPath))) {
        throw new RuntimeException('não foi possível preparar o lock da instalação');
    }
    $lock = fopen($lockPath, 'c+');
    if ($lock === false || ! flock($lock, LOCK_EX | LOCK_NB)) {
        if (is_resource($lock)) {
            fclose($lock);
        }
        throw new RuntimeException('já existe uma instalação, evolução ou remoção em andamento');
    }

    return $lock;
}

function closeInstallationLock($lock): void
{
    if (is_resource($lock)) {
        flock($lock, LOCK_UN);
        fclose($lock);
    }
}

function evolutionIdValid(?string $evolutionId): bool
{
    return $evolutionId !== null && preg_match('/^EVL-[0-9]{8}-[0-9]{4}$/', $evolutionId) === 1;
}

function evolutionBase(string $root, string $evolutionId): string
{
    return $root.'/.ralph/evolutions/'.$evolutionId;
}

/** @return list<array<string, mixed>> */
function evolutionStates(string $root): array
{
    $states = [];
    foreach (glob($root.'/.ralph/evolutions/EVL-*/evolution.json') ?: [] as $path) {
        try {
            $state = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
        } catch (JsonException) {
            continue;
        }
        if (is_array($state) && is_string($state['evolution_id'] ?? null)) {
            $states[] = $state;
        }
    }

    usort($states, static fn (array $left, array $right): int => strcmp((string) ($left['evolution_id'] ?? ''), (string) ($right['evolution_id'] ?? '')));

    return $states;
}

/** @return array<string, mixed>|null */
function findEvolutionState(string $root, ?string $evolutionId = null): ?array
{
    $states = evolutionStates($root);
    if ($evolutionId !== null) {
        foreach ($states as $state) {
            if (($state['evolution_id'] ?? null) === $evolutionId) {
                return $state;
            }
        }
        return null;
    }

    foreach (array_reverse($states) as $state) {
        if (in_array($state['status'] ?? null, ['quarantine_in_progress', 'installing', 'awaiting_acceptance', 'accepted', 'recovery_required'], true)) {
            return $state;
        }
    }

    return null;
}

function nextEvolutionId(string $root): string
{
    $date = gmdate('Ymd');
    $highest = 0;
    foreach (evolutionStates($root) as $state) {
        $id = (string) ($state['evolution_id'] ?? '');
        if (preg_match('/^EVL-'.$date.'-([0-9]{4})$/', $id, $matches) === 1) {
            $highest = max($highest, (int) $matches[1]);
        }
    }

    return sprintf('EVL-%s-%04d', $date, $highest + 1);
}

function signalIsRuntime(array $signal): bool
{
    return ($signal['kind'] ?? null) === 'runtime_ledger'
        || ($signal['kind'] ?? null) === 'runtime_state';
}

/** @return array<string, mixed> */
function evolutionPlan(string $root, array $detected, ?string $provider, string $requestedProvider): array
{
    $plan = installationPlan($root, $detected, $provider, $requestedProvider);
    $installation = $plan['ralph_installation'] ?? [];
    $external = $installation['external'] ?? [];
    $existingState = findEvolutionState($root);
    $movable = [];
    $preserved = [];
    foreach ($external['signals'] ?? [] as $signal) {
        if (signalIsRuntime($signal)) {
            $preserved[] = $signal;
        } else {
            $movable[] = $signal;
        }
    }

    $status = 'blocked';
    $reason = 'nenhuma evolução externa apta foi encontrada';
    if ($existingState !== null && in_array($existingState['status'] ?? null, ['quarantine_in_progress', 'installing', 'recovery_required'], true)) {
        $status = 'recovery_required';
        $reason = 'há uma evolução interrompida que exige recuperação explícita';
    } elseif (($installation['method']['status'] ?? null) === 'managed') {
        $status = 'managed_installation';
        $reason = 'o projeto já possui um manifesto válido do Ralph Method';
    } elseif (($external['status'] ?? null) === 'detected' || ($external['status'] ?? null) === 'ambiguous') {
        $status = 'ready';
        $reason = 'a evolução poderá isolar somente os sinais detectados e instalar o Ralph Method sem importar estado legado';
    } elseif (($external['status'] ?? null) === 'not_found') {
        $status = 'not_applicable';
        $reason = 'não há Ralph externo para evoluir; use plan/apply para uma instalação nova';
    }

    $movablePaths = array_fill_keys(array_map(static fn (array $signal): string => (string) ($signal['path'] ?? ''), $movable), true);
    $plannedFiles = array_map(static function (array $file) use ($movablePaths): array {
        if (($file['action'] ?? null) === 'conflict' && isset($movablePaths[(string) ($file['path'] ?? '')])) {
            $file['action'] = 'quarantine_then_create';
        }
        return $file;
    }, $plan['files']);

    return [
        'schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION,
        'status' => $status,
        'reason' => $reason,
        'project' => $plan['project'],
        'requested_provider' => $requestedProvider,
        'selected_provider' => $provider,
        'ralph_installation' => $installation,
        'migration' => [
            'mode' => 'quarantine_only',
            'state_imported' => false,
            'adapter' => null,
            'unsupported_imports' => ['ledger', 'workflow', 'prompts', 'credentials'],
        ],
        'backup' => [
            'created_on_apply' => true,
            'directory' => null,
            'signals_to_quarantine' => $movable,
            'signals_preserved' => $preserved,
        ],
        'new_installation' => [
            'method_version' => RALPH_METHOD_VERSION,
            'files' => $plannedFiles,
        ],
        'existing_evolution' => $existingState === null ? null : [
            'evolution_id' => $existingState['evolution_id'] ?? null,
            'status' => $existingState['status'] ?? null,
        ],
        'approval_required' => true,
    ];
}

/** @param array<string, mixed> $state */
function updateEvolutionState(array &$state, string $status, ?string $failure = null): void
{
    $state['status'] = $status;
    $state['updated_at'] = gmdate('Y-m-d\TH:i:s\Z');
    if ($failure !== null) {
        $state['failure'] = ['message' => substr($failure, 0, 300)];
    }
    writeJsonStrict((string) $state['state_path'], $state);
}

/** @param array<string, mixed> $state */
function recordEvolutionMove(array &$state, string $phase, string $action, string $path, string $status): void
{
    foreach ($state['journal'] ?? [] as $entry) {
        if (($entry['phase'] ?? null) === $phase
            && ($entry['action'] ?? null) === $action
            && ($entry['path'] ?? null) === $path
            && ($entry['status'] ?? null) === $status) {
            return;
        }
    }
    $state['journal'][] = [
        'sequence' => count($state['journal'] ?? []) + 1,
        'phase' => $phase,
        'action' => $action,
        'path' => $path,
        'status' => $status,
        'timestamp' => gmdate('Y-m-d\TH:i:s\Z'),
    ];
    writeJsonStrict((string) $state['state_path'], $state);
}

/** @param array<string, mixed> $state */
/** @param array<string, mixed> $state */
function legacyTreeMembers(array $state, string $treePath): array
{
    return array_values(array_filter(
        $state['backup']['files'] ?? [],
        static fn (array $member): bool => ($member['tree_path'] ?? null) === $treePath
    ));
}

/** @param array<string, mixed> $state */
function updateLegacyTreeMembers(array &$state, string $treePath, string $status): void
{
    foreach ($state['backup']['files'] as $index => $member) {
        if (($member['tree_path'] ?? null) === $treePath) {
            $state['backup']['files'][$index]['status'] = $status;
        }
    }
}

/** @param array<string, mixed> $state */
function validateLegacyTree(array $state, array $tree, bool $backup): array
{
    $root = (string) $state['project']['root'];
    $base = $root.'/'.($backup ? (string) $tree['backup_path'] : (string) $tree['path']);
    $members = legacyTreeMembers($state, (string) $tree['path']);
    $drift = [];
    $inventory = enumerateLegacyTree($root, $base, (string) $tree['path'], ! $backup);
    if ($inventory['error'] !== null) {
        return [['path' => $tree['path'], 'status' => 'invalid_tree', 'reason' => $inventory['error']]];
    }
    $expectedByRelativePath = [];
    foreach ($members as $member) {
        $expectedByRelativePath[(string) $member['relative_path']] = $member;
    }
    $actualByRelativePath = [];
    foreach ($inventory['members'] as $member) {
        $relative = (string) $member['relative_path'];
        $actualByRelativePath[$relative] = $member;
        if (! isset($expectedByRelativePath[$relative])) {
            $drift[] = ['path' => $tree['path'].'/'.$relative, 'status' => 'unexpected_member'];
            continue;
        }
        $expected = $expectedByRelativePath[$relative];
        if ($member['type'] !== ($expected['type'] ?? null)
            || $member['mode'] !== ($expected['mode'] ?? null)
            || $member['sha256'] !== ($expected['sha256'] ?? null)
            || ($member['link_target'] ?? null) !== ($expected['link_target'] ?? null)) {
            $drift[] = [
                'path' => $expected['path'],
                'expected' => $expected['sha256'],
                'actual' => $member['sha256'],
                'status' => 'modified',
            ];
        }
    }
    foreach ($members as $member) {
        $relative = (string) $member['relative_path'];
        if (! isset($actualByRelativePath[$relative])) {
            $drift[] = ['path' => $member['path'], 'expected' => $member['sha256'], 'actual' => null, 'status' => 'missing'];
        }
    }
    $rootMode = $inventory['root_mode'];
    if ($rootMode !== ($tree['root_mode'] ?? null)) {
        $drift[] = ['path' => $tree['path'], 'expected_mode' => $tree['root_mode'] ?? null, 'actual_mode' => $rootMode, 'status' => 'modified'];
    }
    if (legacyTreeFingerprint($inventory['members'], $rootMode) !== ($tree['tree_fingerprint'] ?? null)) {
        $drift[] = ['path' => $tree['path'], 'status' => 'fingerprint_mismatch'];
    }

    return $drift;
}

/** @param array<string, mixed> $state */
function quarantineLegacyTree(array &$state, array $tree): void
{
    $root = (string) $state['project']['root'];
    $source = $root.'/'.$tree['path'];
    $backup = $root.'/'.$tree['backup_path'];
    if (($tree['status'] ?? null) === 'quarantined' && entryExists($backup)) {
        return;
    }
    if (! entryExists($source)) {
        if (entryExists($backup) && validateLegacyTree($state, $tree, true) === []) {
            $index = null;
            foreach ($state['backup']['trees'] as $candidateIndex => $candidate) {
                if (($candidate['path'] ?? null) === $tree['path']) {
                    $index = $candidateIndex;
                    break;
                }
            }
            if ($index === null) {
                throw new RuntimeException('árvore legada não está registrada no estado: '.$tree['path']);
            }
            $state['backup']['trees'][$index]['status'] = 'quarantined';
            updateLegacyTreeMembers($state, $tree['path'], 'quarantined');
            writeJsonStrict((string) $state['state_path'], $state);
            return;
        }
        throw new RuntimeException('raiz legada ausente durante a quarentena: '.$tree['path']);
    }
    if (validateLegacyTree($state, $tree, false) !== []) {
        throw new RuntimeException('a árvore legada mudou entre o plan e o apply: '.$tree['path']);
    }
    if (! is_dir(dirname($backup)) && ! mkdir(dirname($backup), 0700, true) && ! is_dir(dirname($backup))) {
        throw new RuntimeException('não foi possível preparar o backup recursivo de '.$tree['path']);
    }
    $index = null;
    foreach ($state['backup']['trees'] as $candidateIndex => $candidate) {
        if (($candidate['path'] ?? null) === $tree['path']) {
            $index = $candidateIndex;
            break;
        }
    }
    if ($index === null) {
        throw new RuntimeException('árvore legada não está registrada no estado: '.$tree['path']);
    }
    $state['backup']['trees'][$index]['status'] = 'quarantining';
    updateLegacyTreeMembers($state, $tree['path'], 'quarantining');
    writeJsonStrict((string) $state['state_path'], $state);
    recordEvolutionMove($state, 'quarantine', 'move_tree', $tree['path'], 'before');
    if (! rename($source, $backup)) {
        throw new RuntimeException('não foi possível isolar a árvore legada '.$tree['path']);
    }
    $state['backup']['trees'][$index]['status'] = 'quarantined';
    updateLegacyTreeMembers($state, $tree['path'], 'quarantined');
    recordEvolutionMove($state, 'quarantine', 'move_tree', $tree['path'], 'after');
}

/** @param array<string, mixed> $state */
function restoreEvolutionSignals(array &$state): void
{
    $root = (string) $state['project']['root'];
    foreach (array_reverse(array_keys($state['backup']['trees'] ?? [])) as $treeIndex) {
        $tree = $state['backup']['trees'][$treeIndex];
        if (in_array(($tree['status'] ?? null), ['pending', 'restored'], true)) {
            continue;
        }
        $source = $root.'/'.$tree['path'];
        $backup = $root.'/'.$tree['backup_path'];
        if (($tree['status'] ?? null) === 'restoring' && ! entryExists($backup) && entryExists($source)) {
            if (validateLegacyTree($state, $tree, false) !== []) {
                throw new RuntimeException('restauração interrompida com árvore divergente em '.$tree['path']);
            }
            recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
            $state['backup']['trees'][$treeIndex]['status'] = 'restored';
            updateLegacyTreeMembers($state, $tree['path'], 'restored');
            writeJsonStrict((string) $state['state_path'], $state);
            continue;
        }
        if (($tree['status'] ?? null) === 'quarantining' && ! entryExists($backup) && entryExists($source)) {
            if (validateLegacyTree($state, $tree, false) !== []) {
                throw new RuntimeException('quarentena interrompida com árvore divergente em '.$tree['path']);
            }
            $state['backup']['trees'][$treeIndex]['status'] = 'restored';
            updateLegacyTreeMembers($state, $tree['path'], 'restored');
            recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
            writeJsonStrict((string) $state['state_path'], $state);
            continue;
        }
        if (validateLegacyTree($state, $tree, true) !== []) {
            throw new RuntimeException('backup recursivo ausente ou divergente em '.$tree['path']);
        }
        if (entryExists($source)) {
            throw new RuntimeException('restauração recusada: destino ocupado '.$tree['path']);
        }
        $state['backup']['trees'][$treeIndex]['status'] = 'restoring';
        updateLegacyTreeMembers($state, $tree['path'], 'restoring');
        writeJsonStrict((string) $state['state_path'], $state);
        recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'before');
        if (! rename($backup, $source)) {
            throw new RuntimeException('não foi possível restaurar '.$tree['path']);
        }
        if (validateLegacyTree($state, $tree, false) !== []) {
            throw new RuntimeException('restauração produziu árvore divergente em '.$tree['path']);
        }
        $state['backup']['trees'][$treeIndex]['status'] = 'restored';
        updateLegacyTreeMembers($state, $tree['path'], 'restored');
        recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
    }
    foreach (array_reverse(array_keys($state['backup']['files'] ?? [])) as $index) {
        $file = &$state['backup']['files'][$index];
        if (isset($file['tree_path'])) {
            unset($file);
            continue;
        }
        if (! in_array(($file['status'] ?? null), ['quarantining', 'quarantined', 'restoring'], true)) {
            unset($file);
            continue;
        }
        $destination = $root.'/'.$file['path'];
        $backupPath = $root.'/'.$file['backup_path'];
        if (($file['status'] ?? null) === 'restoring' && entryExists($destination) && ! entryExists($backupPath)) {
            if (! entryMatches($destination, $file)) {
                throw new RuntimeException('restauração interrompida com conteúdo divergente em '.$file['path']);
            }
            recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
            $file['status'] = 'restored';
            writeJsonStrict((string) $state['state_path'], $state);
            unset($file);
            continue;
        }
        if (($file['status'] ?? null) === 'quarantining' && entryExists($destination) && ! entryExists($backupPath)) {
            if (! entryMatches($destination, $file)) {
                throw new RuntimeException('quarentena interrompida com conteúdo divergente em '.$file['path']);
            }
            $file['status'] = 'restored';
            recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
            writeJsonStrict((string) $state['state_path'], $state);
            unset($file);
            continue;
        }
        if (! entryExists($backupPath)) {
            throw new RuntimeException('backup ausente para '.$file['path']);
        }
        if (entryExists($destination)) {
            throw new RuntimeException('restauração recusada: destino ocupado '.$file['path']);
        }
        if (! is_dir(dirname($destination)) && ! mkdir(dirname($destination), 0700, true) && ! is_dir(dirname($destination))) {
            throw new RuntimeException('não foi possível preparar restauração de '.$file['path']);
        }
        $file['status'] = 'restoring';
        writeJsonStrict((string) $state['state_path'], $state);
        recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'before');
        if (! rename($backupPath, $destination)) {
            throw new RuntimeException('não foi possível restaurar '.$file['path']);
        }
        if (! entryMatches($destination, $file)) {
            throw new RuntimeException('restauração produziu conteúdo divergente em '.$file['path']);
        }
        $file['status'] = 'restored';
        recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
        unset($file);
    }
}

/** @param array<string, mixed> $state */
function evolveApply(string $root, array $detected, string $requestedProvider, bool $verifyProviders): void
{
    global $sourceRoot;
    $lock = null;
    $state = null;
    $installed = false;
    try {
        $lock = openInstallationLock($root);
        $existing = findEvolutionState($root);
        if ($existing !== null && ($existing['status'] ?? null) === 'awaiting_acceptance') {
            closeInstallationLock($lock);
            printPlan(['status' => 'already_pending', 'evolution_id' => $existing['evolution_id'], 'state' => '.ralph/evolutions/'.$existing['evolution_id'].'/evolution.json']);
            return;
        }
        if ($existing !== null && in_array($existing['status'] ?? null, ['quarantine_in_progress', 'installing', 'recovery_required'], true)) {
            throw new RuntimeException('há uma evolução interrompida; execute rollback --evolution '.$existing['evolution_id'].' --apply após revisar o estado');
        }

        $detected = detectProject($root, $verifyProviders);
        $provider = selectProvider($detected, $requestedProvider);
        $plan = installationPlan($root, $detected, $provider, $requestedProvider);
        $external = $plan['ralph_installation']['external'] ?? [];
        if (($plan['ralph_installation']['method']['status'] ?? null) === 'managed') {
            throw new RuntimeException('o projeto já possui uma instalação válida do Ralph Method; evolução externa não se aplica');
        }
        if (! in_array($external['status'] ?? null, ['detected', 'ambiguous'], true)) {
            throw new RuntimeException('nenhuma instalação Ralph externa apta para evolução foi encontrada');
        }

        $evolutionId = nextEvolutionId($root);
        $base = evolutionBase($root, $evolutionId);
        $backupBase = $base.'/backup';
        if (! mkdir($backupBase, 0700, true) && ! is_dir($backupBase)) {
            throw new RuntimeException('não foi possível criar o diretório de backup da evolução');
        }
        $state = [
            'schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION,
            'evolution_id' => $evolutionId,
            'status' => 'quarantine_in_progress',
            'created_at' => gmdate('Y-m-d\TH:i:s\Z'),
            'updated_at' => gmdate('Y-m-d\TH:i:s\Z'),
            'state_path' => $base.'/evolution.json',
            'project' => ['root' => $root, 'git' => $plan['project']['git']],
            'source' => [
                'classification' => $external['classification'],
                'confidence' => $external['confidence'],
                'signals' => $external['signals'],
                'legacy_root' => $external['legacy_root'] ?? null,
                'legacy_type' => $external['legacy_type'] ?? null,
                'root_mode' => $external['root_mode'] ?? null,
                'tree_fingerprint' => $external['tree_fingerprint'] ?? null,
                'members' => $external['members'] ?? [],
            ],
            'migration' => [
                'mode' => 'quarantine_only',
                'state_imported' => false,
                'adapter' => null,
                'unsupported_imports' => ['ledger', 'workflow', 'prompts', 'credentials'],
            ],
            'backup' => [
                'directory' => '.ralph/evolutions/'.$evolutionId.'/backup',
                'files' => [],
                'trees' => [],
                'preserved_runtime_paths' => [],
            ],
            'installation' => [
                'method_version' => RALPH_METHOD_VERSION,
                'managed_files' => [],
                'manifest_hash' => null,
            ],
            'rollback' => ['available' => true, 'status' => 'not_started'],
            'journal' => [],
            'staging' => [
                'path' => '.ralph/evolutions/'.$evolutionId.'/backup',
                'status' => 'quarantine_staging',
            ],
        ];
        $legacyRoot = (string) ($external['legacy_root'] ?? '');
        if (($external['legacy_type'] ?? null) === 'legacy_directory' && $legacyRoot !== '') {
            $treeBackupPath = '.ralph/evolutions/'.$evolutionId.'/backup/'.$legacyRoot;
            $state['backup']['trees'][] = [
                'path' => $legacyRoot,
                'backup_path' => $treeBackupPath,
                'root_mode' => $external['root_mode'] ?? null,
                'tree_fingerprint' => $external['tree_fingerprint'] ?? null,
                'member_count' => count($external['members'] ?? []),
                'status' => 'pending',
            ];
            foreach ($external['members'] ?? [] as $member) {
                $relativeMember = (string) ($member['relative_path'] ?? '');
                if (! isSafeRelativePath($relativeMember)) {
                    throw new RuntimeException('membro legado inválido no inventário: '.$relativeMember);
                }
                $state['backup']['files'][] = [
                    'path' => $legacyRoot.'/'.$relativeMember,
                    'relative_path' => $relativeMember,
                    'tree_path' => $legacyRoot,
                    'type' => $member['type'] ?? null,
                    'mode' => $member['mode'] ?? null,
                    'sha256' => $member['sha256'] ?? null,
                    'link_target' => $member['link_target'] ?? null,
                    'backup_path' => $treeBackupPath.'/'.$relativeMember,
                    'status' => 'pending',
                ];
            }
        }
        foreach ($external['signals'] as $signal) {
            $relative = (string) $signal['path'];
            if (($signal['kind'] ?? null) === 'legacy_directory') {
                continue;
            }
            if (signalIsRuntime($signal)) {
                $state['backup']['preserved_runtime_paths'][] = ['path' => $relative, 'sha256' => $signal['sha256']];
                continue;
            }
            $state['backup']['files'][] = [
                'path' => $relative,
                'type' => 'file',
                'mode' => entryMode($root.'/'.$relative),
                'sha256' => $signal['sha256'],
                'backup_path' => '.ralph/evolutions/'.$evolutionId.'/backup/'.$relative,
                'status' => 'pending',
            ];
        }
        writeJsonStrict($state['state_path'], $state);

        foreach ($state['backup']['trees'] as $tree) {
            quarantineLegacyTree($state, $tree);
        }
        foreach ($state['backup']['files'] as $index => $file) {
            if (isset($file['tree_path'])) {
                continue;
            }
            $source = $root.'/'.$file['path'];
            if (! entryExists($source) || ! entryMatches($source, $file)) {
                throw new RuntimeException('o sinal mudou entre o plan e o apply: '.$file['path']);
            }
            $backupPath = $root.'/'.$file['backup_path'];
            if (! is_dir(dirname($backupPath)) && ! mkdir(dirname($backupPath), 0700, true) && ! is_dir(dirname($backupPath))) {
                throw new RuntimeException('não foi possível preparar backup de '.$file['path']);
            }
            $state['backup']['files'][$index]['status'] = 'quarantining';
            writeJsonStrict($state['state_path'], $state);
            recordEvolutionMove($state, 'quarantine', 'move_entry', $file['path'], 'before');
            if (! rename($source, $backupPath)) {
                throw new RuntimeException('não foi possível isolar '.$file['path']);
            }
            $state['backup']['files'][$index]['status'] = 'quarantined';
            recordEvolutionMove($state, 'quarantine', 'move_entry', $file['path'], 'after');
        }

        updateEvolutionState($state, 'installing');
        $freshDetected = detectProject($root, $verifyProviders);
        $freshProvider = selectProvider($freshDetected, $requestedProvider);
        $freshPlan = installationPlan($root, $freshDetected, $freshProvider, $requestedProvider);
        $preservedPaths = array_map(static fn (array $item): string => (string) $item['path'], $state['backup']['preserved_runtime_paths']);
        $installResult = installMethod($root, $freshPlan, $lock, $preservedPaths, true);
        $installed = true;
        $manifest = parseManifest($root.'/.ralph/install-manifest.json', $root);
        if ($manifest === null) {
            throw new RuntimeException('manifesto novo não pôde ser validado após a instalação');
        }
        $state['installation']['method_version'] = $manifest['method_version'];
        $state['installation']['managed_files'] = array_merge(
            $manifest['managed_files'],
            [['path' => '.ralph/install-manifest.json', 'installed_hash' => hashFile($root.'/.ralph/install-manifest.json')]]
        );
        $state['installation']['manifest_hash'] = hashFile($root.'/.ralph/install-manifest.json');
        $state['installation']['provider'] = $installResult['provider'] ?? null;
        updateEvolutionState($state, 'awaiting_acceptance');
        $state['staging']['status'] = 'retained_for_rollback';
        writeJsonStrict($state['state_path'], $state);
        $result = [
            'status' => 'awaiting_acceptance',
            'evolution_id' => $evolutionId,
            'method_version' => RALPH_METHOD_VERSION,
            'migration' => $state['migration'],
            'backup' => $state['backup'],
            'rollback' => ['command' => 'bin/ralph-init rollback --project '.$root.' --evolution '.$evolutionId.' --apply'],
            'accept' => ['command' => 'bin/ralph-init evolve --project '.$root.' --evolution '.$evolutionId.' --accept --apply'],
        ];
        closeInstallationLock($lock);
        printPlan($result);
    } catch (Throwable $exception) {
        if (is_array($state)) {
            try {
                $state['staging']['status'] = 'retained_after_failure';
                updateEvolutionState($state, 'recovery_required', $exception->getMessage());
            } catch (Throwable) {
                // O estado parcial permanece como evidência para o doctor.
            }
        }
        closeInstallationLock($lock);
        fail('evolução não concluída: '.$exception->getMessage(), 4);
    }
}

/** @return list<array<string, mixed>>|null */
function evolutionManagedFiles(string $root, array $state): ?array
{
    $managedFiles = $state['installation']['managed_files'] ?? [];
    if ($managedFiles !== []) {
        return $managedFiles;
    }

    $manifest = parseManifest($root.'/.ralph/install-manifest.json', $root);
    if ($manifest === null || ($manifest['method_version'] ?? null) !== ($state['installation']['method_version'] ?? null)) {
        return null;
    }

    return array_merge(
        $manifest['managed_files'],
        [['path' => '.ralph/install-manifest.json', 'installed_hash' => hashFile($root.'/.ralph/install-manifest.json')]]
    );
}

/** @return array<string, mixed> */
function rollbackPlan(string $root, string $evolutionId): array
{
    $state = findEvolutionState($root, $evolutionId);
    if ($state === null) {
        return ['schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION, 'status' => 'not_found', 'evolution_id' => $evolutionId, 'rollback_allowed' => false];
    }
    if (($state['status'] ?? null) === 'rolled_back') {
        return ['schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION, 'status' => 'already_rolled_back', 'evolution_id' => $evolutionId, 'rollback_allowed' => false];
    }
    $persistedRoot = (string) ($state['project']['root'] ?? '');
    if ($persistedRoot !== $root) {
        return [
            'schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION,
            'status' => 'blocked',
            'reason' => 'o projeto atual não corresponde à raiz registrada na evolução; não seguiria um caminho antigo',
            'evolution_id' => $evolutionId,
            'evolution_status' => $state['status'] ?? null,
            'rollback_allowed' => false,
            'root_mismatch' => ['requested' => $root, 'persisted' => $persistedRoot],
        ];
    }
    $managedFiles = evolutionManagedFiles($root, $state);
    $managedFilesKnown = $managedFiles !== null;
    $managedFiles ??= [];
    $stagingRoot = null;
    if (is_string($state['rollback']['staging_path'] ?? null)) {
        $stagingRoot = $root.'/'.$state['rollback']['staging_path'];
    }
    $drift = [];
    foreach ($managedFiles as $managed) {
        $path = (string) ($managed['path'] ?? '');
        $expected = $managed['installed_hash'] ?? null;
        $actual = hashFile($root.'/'.$path);
        if ($actual === null && $stagingRoot !== null && is_file($stagingRoot.'/'.$path)) {
            $actual = hashFile($stagingRoot.'/'.$path);
        }
        if ($actual !== $expected) {
            $drift[] = ['path' => $path, 'expected' => $expected, 'actual' => $actual];
        }
    }
    $missingBackup = [];
    $occupiedDestinations = [];
    $legacyDrift = [];
    $managedPaths = array_fill_keys(array_map(static fn (array $file): string => (string) ($file['path'] ?? ''), $managedFiles), true);
    foreach ($state['backup']['trees'] ?? [] as $tree) {
        $status = (string) ($tree['status'] ?? 'pending');
        $source = $root.'/'.$tree['path'];
        $backupPath = $root.'/'.$tree['backup_path'];
        if ($status === 'pending') {
            if (! entryExists($source) || validateLegacyTree($state, $tree, false) !== []) {
                $legacyDrift[] = ['path' => $tree['path'], 'status' => 'source_changed_before_quarantine'];
            }
            continue;
        }
        if ($status === 'restored') {
            if (! entryExists($source) || validateLegacyTree($state, $tree, false) !== []) {
                $legacyDrift[] = ['path' => $tree['path'], 'status' => 'restored_tree_drift'];
            }
            continue;
        }
        $restoringInPlace = $status === 'restoring'
            && ! entryExists($backupPath)
            && entryExists($source)
            && validateLegacyTree($state, $tree, false) === [];
        $quarantineIncomplete = $status === 'quarantining'
            && ! entryExists($backupPath)
            && entryExists($source)
            && validateLegacyTree($state, $tree, false) === [];
        if (! $restoringInPlace && ! $quarantineIncomplete) {
            if (! entryExists($backupPath)) {
                $missingBackup[] = $tree['path'];
            } elseif (validateLegacyTree($state, $tree, true) !== []) {
                $legacyDrift[] = ['path' => $tree['path'], 'status' => 'backup_tree_drift'];
            }
            if (entryExists($source)) {
                $occupiedDestinations[] = $tree['path'];
            }
        }
    }
    foreach ($state['backup']['files'] ?? [] as $file) {
        if (isset($file['tree_path'])) {
            continue;
        }
        $status = (string) ($file['status'] ?? 'pending');
        $backupPath = $root.'/'.(string) ($file['backup_path'] ?? '');
        $destination = $root.'/'.(string) ($file['path'] ?? '');
        $inPlace = in_array($status, ['restoring', 'quarantining'], true)
            && ! entryExists($backupPath)
            && entryExists($destination)
            && entryMatches($destination, $file);
        if (! in_array($status, ['pending', 'restored'], true) && ! $inPlace && ! entryExists($backupPath)) {
            $missingBackup[] = $file['path'] ?? null;
        }
        if (! in_array($status, ['pending', 'restored'], true) && ! $inPlace && entryExists($destination) && ! isset($managedPaths[(string) ($file['path'] ?? '')])) {
            $occupiedDestinations[] = $file['path'] ?? null;
        }
    }
    $statusAllowsRollback = in_array($state['status'] ?? null, ['quarantine_in_progress', 'installing', 'awaiting_acceptance', 'accepted', 'recovery_required'], true);
    $installationEvidenceAllowsRollback = $managedFilesKnown
        || in_array($state['status'] ?? null, ['quarantine_in_progress', 'installing'], true)
        || (($state['status'] ?? null) === 'recovery_required'
            && (($state['backup']['files'] ?? []) !== [] || ($state['backup']['trees'] ?? []) !== []));
    $allowed = $drift === [] && $legacyDrift === [] && $missingBackup === [] && $occupiedDestinations === []
        && $statusAllowsRollback && $installationEvidenceAllowsRollback;

    return [
        'schema_version' => RALPH_EVOLUTION_SCHEMA_VERSION,
        'status' => $allowed ? 'ready' : 'blocked',
        'reason' => $allowed ? 'instalação nova sem drift e backup legado disponível' : 'rollback bloqueado por drift, backup ausente, destino ocupado ou recuperação pendente',
        'evolution_id' => $evolutionId,
        'evolution_status' => $state['status'],
        'rollback_allowed' => $allowed,
        'drift' => $drift,
        'legacy_drift' => $legacyDrift,
        'managed_files' => $managedFiles,
        'managed_files_known' => $managedFilesKnown,
        'missing_backup' => $missingBackup,
        'occupied_destinations' => $occupiedDestinations,
        'preserved_runtime_paths' => $state['backup']['preserved_runtime_paths'] ?? [],
    ];
}

function rollbackApply(string $root, string $evolutionId): void
{
    $lock = null;
    $stage = null;
    $movedNew = [];
    $restoredOld = [];
    $recoveryIncomplete = false;
    $state = findEvolutionState($root, $evolutionId);
    try {
        if ($state === null) {
            fail('evolução não encontrada: '.$evolutionId, 2);
        }
        $plan = rollbackPlan($root, $evolutionId);
        if (($plan['rollback_allowed'] ?? false) !== true) {
            fail('rollback bloqueado: '.$plan['reason'], 3);
        }
        $lock = openInstallationLock($root);
        $state = findEvolutionState($root, $evolutionId);
        $plan = rollbackPlan($root, $evolutionId);
        if (($plan['rollback_allowed'] ?? false) !== true) {
            throw new RuntimeException('rollback deixou de estar apto após adquirir o lock');
        }
        $stage = evolutionBase($root, $evolutionId).'/rollback-stage';
        if (! mkdir($stage, 0700, true) && ! is_dir($stage)) {
            throw new RuntimeException('não foi possível criar staging do rollback');
        }
        if (($state['installation']['managed_files'] ?? []) === [] && ($plan['managed_files'] ?? []) !== []) {
            $state['installation']['managed_files'] = $plan['managed_files'];
        }
        $state['rollback']['status'] = 'in_progress';
        $state['rollback']['staging_path'] = '.ralph/evolutions/'.$evolutionId.'/rollback-stage';
        writeJsonStrict((string) $state['state_path'], $state);
        foreach (($plan['managed_files'] ?? []) as $index => $managed) {
            $relative = (string) $managed['path'];
            $source = $root.'/'.$relative;
            $destination = $stage.'/'.$relative;
            if (! is_dir(dirname($destination)) && ! mkdir(dirname($destination), 0700, true) && ! is_dir(dirname($destination))) {
                throw new RuntimeException('não foi possível preparar rollback de '.$relative);
            }
            if (is_file($destination)) {
                if (hashFile($destination) !== ($managed['installed_hash'] ?? null)) {
                    throw new RuntimeException('staging divergente durante rollback de '.$relative);
                }
                $state['installation']['managed_files'][$index]['rollback_status'] = 'staged';
                recordEvolutionMove($state, 'restore', 'move_entry', $relative, 'after');
                writeJsonStrict((string) $state['state_path'], $state);
                $movedNew[] = $relative;
                continue;
            }
            if (! is_file($source)) {
                throw new RuntimeException('arquivo novo ausente durante rollback de '.$relative);
            }
            $state['installation']['managed_files'][$index]['rollback_status'] = 'staging';
            writeJsonStrict((string) $state['state_path'], $state);
            recordEvolutionMove($state, 'restore', 'move_entry', $relative, 'before');
            if (! rename($source, $destination)) {
                throw new RuntimeException('não foi possível retirar a instalação nova de '.$relative);
            }
            $state['installation']['managed_files'][$index]['rollback_status'] = 'staged';
            recordEvolutionMove($state, 'restore', 'move_entry', $relative, 'after');
            $movedNew[] = $relative;
        }
        foreach ($state['backup']['trees'] ?? [] as $treeIndex => $tree) {
            if (in_array(($tree['status'] ?? null), ['pending', 'restored'], true)) {
                continue;
            }
            $backupPath = $root.'/'.$tree['backup_path'];
            $destination = $root.'/'.$tree['path'];
            if (($tree['status'] ?? null) === 'restoring' && ! entryExists($backupPath) && entryExists($destination)) {
                if (validateLegacyTree($state, $tree, false) !== []) {
                    throw new RuntimeException('restauração interrompida com árvore divergente em '.$tree['path']);
                }
                recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
                $state['backup']['trees'][$treeIndex]['status'] = 'restored';
                updateLegacyTreeMembers($state, $tree['path'], 'restored');
                writeJsonStrict((string) $state['state_path'], $state);
                continue;
            }
            if (($tree['status'] ?? null) === 'quarantining' && ! entryExists($backupPath) && entryExists($destination)) {
                if (validateLegacyTree($state, $tree, false) !== []) {
                    throw new RuntimeException('quarentena interrompida com árvore divergente em '.$tree['path']);
                }
                $state['backup']['trees'][$treeIndex]['status'] = 'restored';
                updateLegacyTreeMembers($state, $tree['path'], 'restored');
                recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
                writeJsonStrict((string) $state['state_path'], $state);
                continue;
            }
            if (validateLegacyTree($state, $tree, true) !== []) {
                throw new RuntimeException('backup recursivo ausente ou divergente em '.$tree['path']);
            }
            if (entryExists($destination)) {
                throw new RuntimeException('destino legado ocupado durante rollback: '.$tree['path']);
            }
            $state['backup']['trees'][$treeIndex]['status'] = 'restoring';
            updateLegacyTreeMembers($state, $tree['path'], 'restoring');
            writeJsonStrict((string) $state['state_path'], $state);
            recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'before');
            if (! rename($backupPath, $destination)) {
                throw new RuntimeException('não foi possível restaurar '.$tree['path']);
            }
            if (validateLegacyTree($state, $tree, false) !== []) {
                throw new RuntimeException('restauração produziu árvore divergente em '.$tree['path']);
            }
            $state['backup']['trees'][$treeIndex]['status'] = 'restored';
            updateLegacyTreeMembers($state, $tree['path'], 'restored');
            recordEvolutionMove($state, 'restore', 'move_tree', $tree['path'], 'after');
            $restoredOld[] = $tree['path'];
        }
        foreach ($state['backup']['files'] as $index => $file) {
            if (isset($file['tree_path'])) {
                continue;
            }
            if (in_array(($file['status'] ?? null), ['pending', 'restored'], true)) {
                continue;
            }
            $backupPath = $root.'/'.$file['backup_path'];
            $destination = $root.'/'.$file['path'];
            if (($file['status'] ?? null) === 'restoring' && ! entryExists($backupPath) && entryExists($destination)) {
                if (! entryMatches($destination, $file)) {
                    throw new RuntimeException('restauração interrompida com conteúdo divergente em '.$file['path']);
                }
                recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
                $state['backup']['files'][$index]['status'] = 'restored';
                writeJsonStrict((string) $state['state_path'], $state);
                continue;
            }
            if (($file['status'] ?? null) === 'quarantining' && ! entryExists($backupPath) && entryExists($destination)) {
                if (! entryMatches($destination, $file)) {
                    throw new RuntimeException('quarentena interrompida com conteúdo divergente em '.$file['path']);
                }
                $state['backup']['files'][$index]['status'] = 'restored';
                recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
                writeJsonStrict((string) $state['state_path'], $state);
                continue;
            }
            if (! entryExists($backupPath)) {
                throw new RuntimeException('backup ausente durante rollback: '.$file['path']);
            }
            if (! is_dir(dirname($destination)) && ! mkdir(dirname($destination), 0700, true) && ! is_dir(dirname($destination))) {
                throw new RuntimeException('não foi possível preparar restauração de '.$file['path']);
            }
            $state['backup']['files'][$index]['status'] = 'restoring';
            writeJsonStrict((string) $state['state_path'], $state);
            recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'before');
            if (! rename($backupPath, $destination)) {
                throw new RuntimeException('não foi possível restaurar '.$file['path']);
            }
            if (! entryMatches($destination, $file)) {
                throw new RuntimeException('restauração produziu conteúdo divergente em '.$file['path']);
            }
            $restoredOld[] = $file['path'];
            $state['backup']['files'][$index]['status'] = 'restored';
            recordEvolutionMove($state, 'restore', 'move_entry', $file['path'], 'after');
        }
        $state['rollback'] = ['available' => false, 'status' => 'applied', 'applied_at' => gmdate('Y-m-d\TH:i:s\Z')];
        $state['staging'] = ['path' => '.ralph/evolutions/'.$evolutionId.'/rollback-stage', 'status' => 'removed_after_rollback'];
        updateEvolutionState($state, 'rolled_back');
        removeTree($stage);
        closeInstallationLock($lock);
        printPlan(['status' => 'rolled_back', 'evolution_id' => $evolutionId, 'restored_paths' => $restoredOld, 'new_installation_removed' => $movedNew]);
    } catch (Throwable $exception) {
        if (is_array($state) && is_string($stage)) {
            foreach (array_reverse($restoredOld) as $relative) {
                $destination = $root.'/'.$relative;
                $matchingIndex = null;
                $backupPath = $root.'/';
                foreach ($state['backup']['files'] ?? [] as $index => $file) {
                    if (($file['path'] ?? null) === $relative) {
                        $matchingIndex = $index;
                        $backupPath .= (string) ($file['backup_path'] ?? '');
                        break;
                    }
                }
                if (is_file($destination) && $backupPath !== $root.'/' && ! is_file($backupPath)) {
                    @mkdir(dirname($backupPath), 0700, true);
                    if ($matchingIndex !== null) {
                        $state['backup']['files'][$matchingIndex]['status'] = 'restoring';
                    }
                    if (@rename($destination, $backupPath)) {
                        if ($matchingIndex !== null) {
                            $state['backup']['files'][$matchingIndex]['status'] = 'quarantined';
                        }
                    } else {
                        $recoveryIncomplete = true;
                    }
                }
            }
            if ($movedNew !== []) {
                $recoveryIncomplete = true;
            }
        }
        if (is_array($state)) {
            try {
                if ($recoveryIncomplete) {
                    $state['rollback']['staging_path'] = '.ralph/evolutions/'.$evolutionId.'/rollback-stage';
                }
                updateEvolutionState($state, 'recovery_required', $exception->getMessage());
            } catch (Throwable) {
                // Mantém a falha no stderr quando a escrita do estado também falha.
            }
        }
        // O staging fica disponível para a próxima tentativa de recuperação.
        closeInstallationLock($lock);
        fail('rollback não concluído: '.$exception->getMessage(), 4);
    }
}

function acceptEvolution(string $root, string $evolutionId): void
{
    $state = findEvolutionState($root, $evolutionId);
    if ($state === null) {
        fail('evolução não encontrada: '.$evolutionId, 2);
    }
    if (($state['status'] ?? null) === 'accepted') {
        printPlan(['status' => 'already_accepted', 'evolution_id' => $evolutionId]);
        return;
    }
    $plan = rollbackPlan($root, $evolutionId);
    if (($plan['rollback_allowed'] ?? false) !== true || ($state['status'] ?? null) !== 'awaiting_acceptance') {
        fail('aceitação bloqueada: a instalação nova possui drift ou não está aguardando aceite', 3);
    }
    $lock = null;
    try {
        $lock = openInstallationLock($root);
        $state = findEvolutionState($root, $evolutionId);
        $plan = rollbackPlan($root, $evolutionId);
        if (($plan['rollback_allowed'] ?? false) !== true || ($state['status'] ?? null) !== 'awaiting_acceptance') {
            throw new RuntimeException('aceitação deixou de estar apta após adquirir o lock');
        }
        $state['accepted_at'] = gmdate('Y-m-d\TH:i:s\Z');
        updateEvolutionState($state, 'accepted');
        closeInstallationLock($lock);
        printPlan(['status' => 'accepted', 'evolution_id' => $evolutionId, 'backup_preserved' => true]);
    } catch (Throwable $exception) {
        closeInstallationLock($lock);
        fail('aceitação não concluída: '.$exception->getMessage(), 4);
    }
}

function uninstall(string $root, bool $apply): void
{
    $lock = null;
    if ($apply) {
        $lockPath = $root.'/.ralph/install.lock';
        if (! is_dir(dirname($lockPath)) && ! mkdir(dirname($lockPath), 0700, true) && ! is_dir(dirname($lockPath))) {
            fail('não foi possível preparar o lock da desinstalação');
        }
        $lock = fopen($lockPath, 'c+');
        if ($lock === false || ! flock($lock, LOCK_EX | LOCK_NB)) {
            if (is_resource($lock)) {
                fclose($lock);
            }
            fail('já existe uma instalação ou remoção em andamento', 4);
        }
    }

    $manifestPath = $root.'/.ralph/install-manifest.json';
    $manifest = readManifest($manifestPath, $root);
    $files = [];
    foreach ($manifest['managed_files'] as $managed) {
        $path = (string) ($managed['path'] ?? '');
        $absolute = $root.'/'.$path;
        $currentHash = hashFile($absolute);
        $installedHash = $managed['installed_hash'] ?? null;
        $action = $currentHash === null ? 'missing' : ($currentHash === $installedHash ? 'remove' : 'preserve_modified');
        $files[] = ['path' => $path, 'action' => $action];
    }
    $plan = ['status' => $apply ? 'uninstalling' : 'uninstall_plan', 'preserves_runtime' => true, 'files' => $files];
    if (! $apply) {
        printPlan($plan);
        return;
    }

    $backup = $root.'/.ralph/.uninstall-backup-'.bin2hex(random_bytes(6));
    $moved = [];
    foreach ($files as $file) {
        if ($file['action'] === 'remove') {
            $source = $root.'/'.$file['path'];
            $backupPath = $backup.'/'.$file['path'];
            $directory = dirname($backupPath);
            if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
                fail('não foi possível preparar backup da remoção', 4);
            }
            if (! rename($source, $backupPath)) {
                foreach (array_reverse($moved) as $restored) {
                    @rename($backup.'/'.$restored, $root.'/'.$restored);
                }
                removeTree($backup);
                if (is_resource($lock)) {
                    flock($lock, LOCK_UN);
                    fclose($lock);
                }
                fail('desinstalação revertida; não foi possível remover '.$file['path'], 4);
            }
            $moved[] = $file['path'];
        }
    }
    $manifestBackup = $backup.'/.ralph/install-manifest.json';
    if (! is_dir(dirname($manifestBackup)) && ! mkdir(dirname($manifestBackup), 0700, true) && ! is_dir(dirname($manifestBackup))) {
        fail('não foi possível preparar backup do manifesto', 4);
    }
    if (! rename($manifestPath, $manifestBackup)) {
        foreach (array_reverse($moved) as $restored) {
            @rename($backup.'/'.$restored, $root.'/'.$restored);
        }
        removeTree($backup);
        if (is_resource($lock)) {
            flock($lock, LOCK_UN);
            fclose($lock);
        }
        fail('desinstalação revertida; não foi possível remover o manifesto', 4);
    }
    writeJson($root.'/.ralph/uninstall-report.json', [
        'schema_version' => RALPH_INSTALL_SCHEMA_VERSION,
        'uninstalled_at' => gmdate('Y-m-d\\TH:i:s\\Z'),
        'preserves_runtime' => true,
        'files' => $files,
        'preserved_paths' => ['.git/ralph-control', '.git/ralph-control/workflow.json', '.ralph/handoffs', '.ralph/reports'],
    ]);
    removeTree($backup);
    if (is_resource($lock)) {
        flock($lock, LOCK_UN);
        fclose($lock);
    }
    printPlan(['status' => 'uninstalled', 'report' => '.ralph/uninstall-report.json', 'preserves_runtime' => true, 'files' => $files]);
}

function doctor(string $root, bool $verifyProviders): void
{
    $manifestPath = $root.'/.ralph/install-manifest.json';
    $detected = detectProject($root, $verifyProviders);
    if (! is_file($manifestPath)) {
        $ralphInstallation = detectExistingRalphInstallation($root, null);
        printPlan([
            'status' => ($ralphInstallation['external']['status'] ?? 'not_found') === 'not_found'
                ? 'not_installed'
                : 'external_ralph_detected',
            'project' => $root,
            'ralph_installation' => $ralphInstallation,
            'provider_verification' => $detected['verification'],
            'providers' => $detected['providers'],
        ]);
        return;
    }
    $manifest = parseManifest($manifestPath, $root);
    if ($manifest === null) {
        $ralphInstallation = detectExistingRalphInstallation($root, null);
        printPlan([
            'status' => 'invalid_installation',
            'project' => $root,
            'ralph_installation' => $ralphInstallation,
            'provider_verification' => $detected['verification'],
            'providers' => $detected['providers'],
        ]);
        return;
    }
    $ralphInstallation = detectExistingRalphInstallation($root, $manifest);
    $drift = [];
    foreach ($manifest['managed_files'] as $managed) {
        $path = (string) $managed['path'];
        $actual = hashFile($root.'/'.$path);
        if ($actual !== ($managed['installed_hash'] ?? null)) {
            $drift[] = ['path' => $path, 'status' => $actual === null ? 'missing' : 'modified'];
        }
    }
    printPlan([
        'status' => $drift === [] ? 'healthy' : 'drift_detected',
        'method_version' => $manifest['method_version'] ?? null,
        'provider' => $manifest['orchestration']['primary_runner'] ?? null,
        'drift' => $drift,
        'runtime_preserved' => is_dir($root.'/.git/ralph-control'),
        'ralph_installation' => $ralphInstallation,
        'provider_verification' => $detected['verification'],
        'providers' => $detected['providers'],
    ]);
}

$arguments = arguments($argv);
$root = projectRoot($arguments['project']);
$manifestPath = $root.'/.ralph/install-manifest.json';

try {
    if ($arguments['command'] === 'rollback') {
        if (! evolutionIdValid($arguments['evolution_id'])) {
            fail('rollback exige --evolution EVL-YYYYMMDD-NNNN', 2);
        }
        if ($arguments['apply']) {
            rollbackApply($root, (string) $arguments['evolution_id']);
        } else {
            printPlan(rollbackPlan($root, (string) $arguments['evolution_id']));
        }
        exit(0);
    }
    if ($arguments['command'] === 'uninstall') {
        uninstall($root, $arguments['apply']);
        exit(0);
    }
    if ($arguments['command'] === 'doctor') {
        doctor($root, $arguments['verify_providers']);
        exit(0);
    }
    $detected = detectProject($root, $arguments['verify_providers']);
    $provider = selectProvider($detected, $arguments['provider']);
    if ($arguments['command'] === 'evolve') {
        if ($arguments['accept']) {
            if (! evolutionIdValid($arguments['evolution_id']) || ! $arguments['apply']) {
                fail('aceitação exige --evolution EVL-YYYYMMDD-NNNN e --apply', 2);
            }
            acceptEvolution($root, (string) $arguments['evolution_id']);
            exit(0);
        }
        $evolutionPlan = evolutionPlan($root, $detected, $provider, $arguments['provider']);
        if (! $arguments['apply']) {
            printPlan($evolutionPlan);
            exit(0);
        }
        evolveApply($root, $detected, $arguments['provider'], $arguments['verify_providers']);
        exit(0);
    }
    $plan = installationPlan($root, $detected, $provider, $arguments['provider']);
    if ($arguments['command'] === 'plan') {
        printPlan($plan);
        exit(0);
    }
    if ($arguments['command'] === 'apply') {
        applyInstallation($root, $plan);
        exit(0);
    }
} catch (JsonException $exception) {
    fail('JSON inválido: '.$exception->getMessage());
}
