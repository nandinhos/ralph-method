#!/usr/bin/env php
<?php

declare(strict_types=1);

const RALPH_METHOD_VERSION = '0.6.0';
const RALPH_INSTALL_SCHEMA_VERSION = '1.0.0';

$sourceRoot = realpath(getenv('RALPH_METHOD_SOURCE') ?: dirname(__DIR__)) ?: dirname(__DIR__);

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, "erro: {$message}\n");
    exit($code);
}

/** @return array{command: string, project: string, provider: string, apply: bool, verify_providers: bool} */
function arguments(array $argv): array
{
    $command = $argv[1] ?? 'plan';
    if (str_starts_with($command, '--')) {
        $command = 'plan';
        $offset = 1;
    } else {
        $offset = 2;
    }
    $result = [
        'command' => $command,
        'project' => getcwd() ?: '.',
        'provider' => 'auto',
        'apply' => false,
        'verify_providers' => false,
    ];
    for ($index = $offset; $index < count($argv); $index++) {
        $argument = $argv[$index];
        if ($argument === '--apply') {
            $result['apply'] = true;
            continue;
        }
        if ($argument === '--verify-providers') {
            $result['verify_providers'] = true;
            continue;
        }
        if (str_starts_with($argument, '--project=')) {
            $result['project'] = substr($argument, 10);
            continue;
        }
        if ($argument === '--project') {
            $result['project'] = $argv[++$index] ?? '';
            continue;
        }
        if (str_starts_with($argument, '--provider=')) {
            $result['provider'] = substr($argument, 11);
            continue;
        }
        if ($argument === '--provider') {
            $result['provider'] = $argv[++$index] ?? '';
            continue;
        }
        if (in_array($argument, ['--help', '-h'], true)) {
            echo "uso: bin/ralph-init plan|apply|uninstall|doctor --project <path> [--provider auto|codex|claude|opencode|hermes|agy] [--verify-providers] [--apply]\n";
            exit(0);
        }
        fail("argumento desconhecido: {$argument}", 2);
    }
    if (! in_array($result['command'], ['plan', 'apply', 'uninstall', 'doctor'], true)) {
        fail('comando inválido; use plan, apply, uninstall ou doctor', 2);
    }
    if (! in_array($result['provider'], ['auto', 'codex', 'claude', 'opencode', 'hermes', 'agy'], true)) {
        fail('provider inválido', 2);
    }

    return $result;
}

function projectRoot(string $path): string
{
    $root = realpath($path);
    if ($root === false || ! is_dir($root)) {
        fail("projeto não encontrado: {$path}", 2);
    }
    $command = 'git -C '.escapeshellarg($root).' rev-parse --show-toplevel 2>/dev/null';
    $gitRoot = trim((string) shell_exec($command));
    if ($gitRoot === '') {
        fail('o projeto precisa ser um checkout Git', 2);
    }

    return realpath($gitRoot) ?: $gitRoot;
}

/** @return array{exit: int, output: string, timed_out: bool} */
function commandResult(string $command, string $cwd, int $timeoutSeconds = 8): array
{
    $timeoutBinary = trim((string) shell_exec('command -v timeout 2>/dev/null'));
    $usesExternalTimeout = $timeoutBinary !== '';
    $runCommand = $usesExternalTimeout
        ? commandLine($timeoutBinary, ['--signal=TERM', '--kill-after=1s', $timeoutSeconds.'s', 'sh', '-c', $command])
        : $command;
    $process = proc_open($runCommand, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $cwd);
    if (! is_resource($process)) {
        return ['exit' => 1, 'output' => '', 'timed_out' => false];
    }
    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $output = '';
    $timedOut = false;
    $deadline = microtime(true) + $timeoutSeconds;
    while (true) {
        $status = proc_get_status($process);
        $output .= (string) stream_get_contents($pipes[1]).(string) stream_get_contents($pipes[2]);
        if (! ($status['running'] ?? false)) {
            break;
        }
        if (! $usesExternalTimeout && microtime(true) >= $deadline) {
            proc_terminate($process, 15);
            usleep(100000);
            if (proc_get_status($process)['running'] ?? false) {
                proc_terminate($process, 9);
            }
            $timedOut = true;
            break;
        }
        usleep(20000);
    }
    $output .= (string) stream_get_contents($pipes[1]).(string) stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($process);
    $timedOut = $timedOut || ($usesExternalTimeout && in_array($exit, [124, 137, 143], true));

    return ['exit' => $timedOut ? 124 : $exit, 'output' => trim($output), 'timed_out' => $timedOut];
}

function commandLine(string $path, array $arguments = []): string
{
    return escapeshellarg($path).($arguments === [] ? '' : ' '.implode(' ', array_map('escapeshellarg', $arguments)));
}

function sanitizeProviderText(string $output): string
{
    $line = trim((string) (preg_split('/\R/', $output, 2)[0] ?? ''));
    $redacted = preg_replace('/(token|api[_-]?key|secret|password|authorization|bearer)\s*[:=]\s*\S+/i', '[redacted]', $line);

    return substr($redacted === null ? '' : $redacted, 0, 160);
}

/** @return array<string, array<string, mixed>> */
function providerDefinitions(): array
{
    return [
        'codex' => [
            'auth' => ['args' => ['login', 'status'], 'classifier' => 'codex'],
            'health' => ['args' => ['doctor', '--json']],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'claude' => [
            'auth' => ['args' => ['auth', 'status', '--json']],
            'health' => ['args' => ['auth', 'status', '--json']],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'opencode' => [
            'auth' => ['args' => ['auth', 'list'], 'classifier' => 'opencode_credentials'],
            'health' => ['args' => ['models'], 'classifier' => 'opencode_models'],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'hermes' => [
            'auth' => ['args' => ['auth', 'status'], 'requires_env' => 'RALPH_HERMES_PROVIDER'],
            'health' => ['args' => ['status']],
            'runner_supported' => false,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'agy' => [
            'auth' => null,
            'health' => null,
            'runner_supported' => false,
            'capabilities' => ['execution', 'model_selection'],
        ],
    ];
}

function stripAnsi(string $output): string
{
    $plain = preg_replace('/\x1B\[[0-?]*[ -\/]*[@-~]/', '', $output);

    return $plain === null ? $output : $plain;
}

function sanitizeProviderIdentifier(string $value): string
{
    $sanitized = preg_replace('/[^\p{L}\p{N} ._:+-]/u', '', trim($value));

    return substr(trim($sanitized === null ? '' : $sanitized), 0, 64);
}

function hasOpenCodeCredentialSignal(string $output): bool
{
    return preg_match('/^\s*[●•*]\s+.+\s+(?:api|oauth)\s*$/miu', stripAnsi($output)) === 1;
}

function hasOpenCodeModelSignal(string $output): bool
{
    return preg_match('/^\s*[a-z0-9][a-z0-9_.-]*\/[a-z0-9][a-z0-9_.-]*(?:\s|$)/mi', stripAnsi($output)) === 1;
}

function extractHermesProvider(string $output): string
{
    if (preg_match('/^\s*Provider:\s*(\S.+?)\s*$/mi', stripAnsi($output), $matches) !== 1) {
        return '';
    }

    return sanitizeProviderIdentifier($matches[1]);
}

function hermesHealthPassed(array $result, string $providerTarget): bool
{
    if (($result['timed_out'] ?? false) === true || ($result['exit'] ?? 1) !== 0) {
        return false;
    }
    $output = stripAnsi((string) ($result['output'] ?? ''));
    $provider = extractHermesProvider($output);
    if ($provider === '' || strcasecmp($provider, $providerTarget) !== 0) {
        return false;
    }

    return preg_match('/^\s*Model:\s*\S.+?\s*$/mi', $output) === 1;
}

function hasUnauthenticatedSignal(string $output): bool
{
    return preg_match('/not[ _-]*(logged[ _-]*in|authenticated)|unauthenticated|authentication required|login required|no credentials|credential[s]? (missing|not configured)|invalid (token|credential)|token expired|expired credential|"(loggedIn|authenticated|valid|configured)"\s*:\s*false/i', $output) === 1;
}

function hasAuthenticatedSignal(string $output): bool
{
    return preg_match('/logged[ _-]+in|authenticated|"(loggedIn|authenticated|valid|configured)"\s*:\s*true|credentials?\s+(available|configured|valid)/i', $output) === 1;
}

function classifyAuth(array $result, string $classifier): string
{
    if (($result['timed_out'] ?? false) === true) {
        return 'unknown';
    }
    $output = (string) ($result['output'] ?? '');
    if ($classifier === 'opencode_credentials') {
        if (($result['exit'] ?? 1) !== 0) {
            return hasUnauthenticatedSignal($output) ? 'unauthenticated' : 'unknown';
        }
        if (hasOpenCodeCredentialSignal($output)) {
            return 'authenticated';
        }
        if (hasUnauthenticatedSignal($output)) {
            return 'unauthenticated';
        }

        return 'unknown';
    }
    if (hasUnauthenticatedSignal($output)) {
        return 'unauthenticated';
    }
    if (hasAuthenticatedSignal($output)) {
        return 'authenticated';
    }
    if (($result['exit'] ?? 1) !== 0) {
        return 'unknown';
    }
    if ($classifier === 'codex') {
        return 'authenticated';
    }

    return 'unknown';
}

function providerReason(string $status, string $authStatus, string $healthStatus, bool $verified, bool $runnerSupported = true): string
{
    if (! $verified) {
        return 'verificação explícita ainda não solicitada';
    }
    if ($status === 'functional') {
        return $runnerSupported
            ? 'autenticação e diagnóstico local não generativo aprovados'
            : 'CLI autenticada e saudável; adapter de execução ainda não está disponível';
    }
    if ($status === 'unsupported') {
        return 'provider não possui probe seguro registrado';
    }
    if ($authStatus === 'unauthenticated') {
        return 'sessão ou credencial não autenticada';
    }
    if ($authStatus !== 'authenticated') {
        return 'o diagnóstico não confirmou autenticação';
    }
    if ($healthStatus === 'unhealthy') {
        return 'diagnóstico local do provider falhou';
    }

    return 'funcionalidade não comprovada pelo probe seguro';
}

function healthPassed(string $classifier, array $result, ?string $providerTarget = null): bool
{
    if (($result['timed_out'] ?? false) === true || ($result['exit'] ?? 1) !== 0) {
        return false;
    }
    $output = (string) ($result['output'] ?? '');
    if ($classifier === 'opencode_models') {
        return hasOpenCodeModelSignal($output);
    }
    if ($classifier === 'hermes_status') {
        return $providerTarget !== null && hermesHealthPassed($result, $providerTarget);
    }

    return ! hasUnauthenticatedSignal($output);
}

/** @return array<string, mixed> */
function verifyHermesProvider(string $path, string $root, array $definition, array $base): array
{
    $statusResult = commandResult(commandLine($path, $definition['health']['args']), $root);
    $providerTarget = sanitizeProviderIdentifier((string) getenv('RALPH_HERMES_PROVIDER'));
    if ($providerTarget === '') {
        $providerTarget = extractHermesProvider((string) ($statusResult['output'] ?? ''));
    }
    if ($providerTarget === '') {
        $base['status'] = 'authentication_unknown';
        $base['reason'] = 'provider alvo não informado e não foi identificado no diagnóstico Hermes';
        $base['verification']['health_exit'] = $statusResult['exit'];
        $base['verification']['health_timed_out'] = $statusResult['timed_out'];

        return $base;
    }

    $authArgs = $definition['auth']['args'];
    $authArgs[] = $providerTarget;
    $authResult = commandResult(commandLine($path, $authArgs), $root);
    $authStatus = classifyAuth($authResult, 'hermes');
    $base['auth_status'] = $authStatus;
    $base['verification']['provider_target'] = $providerTarget;
    $base['verification']['auth_exit'] = $authResult['exit'];
    $base['verification']['auth_timed_out'] = $authResult['timed_out'];
    if ($authStatus !== 'authenticated') {
        $base['status'] = $authStatus === 'unauthenticated' ? 'unauthenticated' : 'authentication_unknown';
        $base['reason'] = providerReason($base['status'], $authStatus, 'unsupported', true, $base['runner_supported']);

        return $base;
    }

    $healthStatus = healthPassed('hermes_status', $statusResult, $providerTarget) ? 'healthy' : 'unhealthy';
    $base['health_status'] = $healthStatus;
    $base['verification']['health_exit'] = $statusResult['exit'];
    $base['verification']['health_timed_out'] = $statusResult['timed_out'];
    $base['status'] = $healthStatus === 'healthy' ? 'functional' : 'degraded';
    $base['adapter_enabled'] = $base['status'] === 'functional' && $base['runner_supported'];
    $base['reason'] = providerReason($base['status'], $authStatus, $healthStatus, true, $base['runner_supported']);

    return $base;
}

/** @return array<string, mixed> */
function verifyProvider(string $provider, string $path, string $root): array
{
    $definition = providerDefinitions()[$provider] ?? null;
    $base = [
        'verification' => [
            'requested' => true,
            'mode' => 'safe',
            'probe_kind' => 'diagnostic',
            'checked_at' => gmdate('Y-m-d\\TH:i:s\\Z'),
        ],
        'auth_status' => 'unknown',
        'health_status' => 'unsupported',
        'status' => 'unsupported',
        'adapter_enabled' => false,
        'runner_supported' => (bool) ($definition['runner_supported'] ?? false),
        'capabilities' => $definition['capabilities'] ?? [],
    ];
    if ($definition === null || $definition['auth'] === null || $definition['health'] === null) {
        $base['reason'] = providerReason('unsupported', 'unknown', 'unsupported', true);
        return $base;
    }
    if ($provider === 'hermes') {
        return verifyHermesProvider($path, $root, $definition, $base);
    }
    $requiredEnv = $definition['auth']['requires_env'] ?? null;
    $providerTarget = $requiredEnv !== null ? trim((string) getenv($requiredEnv)) : '';
    if ($requiredEnv !== null && $providerTarget === '') {
        $base['auth_status'] = 'unknown';
        $base['status'] = 'authentication_unknown';
        $base['reason'] = 'provider alvo não informado em '.$requiredEnv;
        return $base;
    }
    $authArgs = $definition['auth']['args'];
    if ($providerTarget !== '') {
        $authArgs[] = $providerTarget;
    }
    $authResult = commandResult(commandLine($path, $authArgs), $root);
    $authStatus = classifyAuth($authResult, (string) ($definition['auth']['classifier'] ?? 'exit_zero'));
    $base['auth_status'] = $authStatus;
    $base['verification']['auth_exit'] = $authResult['exit'];
    $base['verification']['auth_timed_out'] = $authResult['timed_out'];
    if ($authStatus !== 'authenticated') {
        $base['status'] = $authStatus === 'unauthenticated' ? 'unauthenticated' : 'authentication_unknown';
        $base['reason'] = providerReason($base['status'], $authStatus, 'unsupported', true, $base['runner_supported']);
        return $base;
    }

    $healthArgs = $definition['health']['args'];
    $healthResult = commandResult(commandLine($path, $healthArgs), $root);
    $healthClassifier = (string) ($definition['health']['classifier'] ?? 'exit_zero');
    $healthStatus = healthPassed($healthClassifier, $healthResult) ? 'healthy' : 'unhealthy';
    $base['health_status'] = $healthStatus;
    $base['verification']['health_exit'] = $healthResult['exit'];
    $base['verification']['health_timed_out'] = $healthResult['timed_out'];
    $base['status'] = $healthStatus === 'healthy' ? 'functional' : 'degraded';
    $base['adapter_enabled'] = $base['status'] === 'functional' && $base['runner_supported'];
    $base['reason'] = providerReason($base['status'], $authStatus, $healthStatus, true, $base['runner_supported']);

    return $base;
}

/** @return array<string, mixed> */
function detectProject(string $root, bool $verifyProviders = false): array
{
    $commands = ['codex', 'claude', 'opencode', 'hermes', 'agy'];
    $definitions = providerDefinitions();
    $providers = [];
    foreach ($commands as $command) {
        $path = trim((string) shell_exec('command -v '.escapeshellarg($command).' 2>/dev/null'));
        $version = null;
        if ($path !== '') {
            $result = commandResult(commandLine($path, ['--version']), $root, 5);
            $version = $result['exit'] === 0 ? sanitizeProviderText($result['output']) : null;
        }
        $providers[$command] = [
            'installed' => $path !== '',
            'path' => $path !== '' ? $path : null,
            'version' => $version,
            'auth_status' => 'not_checked',
            'health_status' => 'not_checked',
            'status' => $path === '' ? 'unavailable' : 'detected',
            'adapter_enabled' => false,
            'runner_supported' => (bool) ($definitions[$command]['runner_supported'] ?? false),
            'capabilities' => $definitions[$command]['capabilities'] ?? [],
            'verification' => [
                'requested' => $verifyProviders,
                'mode' => $verifyProviders ? 'safe' : 'none',
                'probe_kind' => 'diagnostic',
                'checked_at' => null,
            ],
            'reason' => $path === '' ? 'executável não encontrado' : 'provider detectado; autenticação não verificada',
        ];
        if ($verifyProviders && $path !== '') {
            $providers[$command] = array_merge($providers[$command], verifyProvider($command, $path, $root));
        }
    }

    $signals = [
        'codex' => is_dir($root.'/.codex') || is_dir($root.'/.codex-plugin'),
        'claude' => is_dir($root.'/.claude') || is_dir($root.'/.claude-plugin') || is_file($root.'/CLAUDE.md'),
        'opencode' => is_dir($root.'/.opencode') || is_file($root.'/opencode.json') || is_file($root.'/opencode.yaml') || is_file($root.'/opencode.toml'),
    ];
    $testCommand = null;
    if (is_file($root.'/bin/check')) {
        $testCommand = 'bin/check';
    } elseif (is_file($root.'/composer.json')) {
        $testCommand = 'composer test';
    } elseif (is_file($root.'/package.json')) {
        $testCommand = 'npm test';
    } elseif (is_file($root.'/pyproject.toml') || is_file($root.'/pytest.ini')) {
        $testCommand = 'pytest';
    } elseif (is_file($root.'/go.mod')) {
        $testCommand = 'go test ./...';
    } elseif (is_file($root.'/Cargo.toml')) {
        $testCommand = 'cargo test';
    }
    $git = [
        'commit' => trim((string) shell_exec('git -C '.escapeshellarg($root).' rev-parse HEAD 2>/dev/null')),
        'branch' => trim((string) shell_exec('git -C '.escapeshellarg($root).' branch --show-current 2>/dev/null')),
        'working_tree_clean' => trim((string) shell_exec('git -C '.escapeshellarg($root).' status --porcelain 2>/dev/null')) === '',
    ];

    return [
        'providers' => $providers,
        'verification' => [
            'requested' => $verifyProviders,
            'mode' => $verifyProviders ? 'safe' : 'none',
            'live_generation_probe' => false,
        ],
        'harness_signals' => $signals,
        'test_command' => $testCommand,
        'git' => $git,
        'context_files' => array_values(array_filter(['AGENTS.md', 'CLAUDE.md', 'docs/agents', '.spec'], static fn (string $path): bool => file_exists($root.'/'.$path))),
    ];
}

function selectProvider(array $detected, string $requested): ?string
{
    if ($requested !== 'auto') {
        if (! ($detected['providers'][$requested]['installed'] ?? false)) {
            fail("provider {$requested} não está instalado", 2);
        }

        return $requested;
    }
    foreach (providerOrder() as $candidate) {
        if (($detected['harness_signals'][$candidate] ?? false) && ($detected['providers'][$candidate]['adapter_enabled'] ?? false)) {
            return $candidate;
        }
    }
    foreach (providerOrder() as $candidate) {
        if ($detected['providers'][$candidate]['adapter_enabled'] ?? false) {
            return $candidate;
        }
    }

    return null;
}

/** @return list<string> */
function providerOrder(): array
{
    return ['codex', 'claude', 'opencode', 'hermes', 'agy'];
}

/** @return list<string> */
function providersWithStatus(array $detected, string $status): array
{
    return array_values(array_filter(
        providerOrder(),
        static fn (string $provider): bool => ($detected['providers'][$provider]['status'] ?? null) === $status
    ));
}

/** @return list<string> */
function availableRunners(array $detected): array
{
    return array_values(array_filter(
        providerOrder(),
        static fn (string $provider): bool => ($detected['providers'][$provider]['adapter_enabled'] ?? false) === true
    ));
}

function providerAdapterEnabled(array $detected, ?string $provider): bool
{
    return $provider !== null && ($detected['providers'][$provider]['adapter_enabled'] ?? false) === true;
}

function hashFile(string $path): ?string
{
    return is_file($path) ? hash_file('sha256', $path) ?: null : null;
}

function writeJson(string $path, array $value): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        fail("não foi possível criar {$directory}");
    }
    $temporary = $path.'.tmp.'.bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
    if (file_put_contents($temporary, $json, LOCK_EX) === false || ! rename($temporary, $path)) {
        @unlink($temporary);
        fail("não foi possível escrever {$path}");
    }
}

