#!/usr/bin/env php
<?php

declare(strict_types=1);

const RALPH_METHOD_VERSION = '0.9.2';
const RALPH_INSTALL_SCHEMA_VERSION = '1.0.0';
const RALPH_INSTALL_DETECTION_SCHEMA_VERSION = '1.1.0';
const RALPH_EVOLUTION_SCHEMA_VERSION = '1.1.0';

$sourceRoot = realpath(getenv('RALPH_METHOD_SOURCE') ?: dirname(__DIR__)) ?: dirname(__DIR__);

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, "erro: {$message}\n");
    exit($code);
}

/** @return array{command: string, project: string, provider: string, apply: bool, verify_providers: bool, evolution_id: ?string, accept: bool} */
function arguments(array $argv): array
{
    $command = $argv[1] ?? 'plan';
    if (str_starts_with($command, '--')) {
        $command = 'plan';
        $offset = 1;
    } else {
        $offset = 2;
    }
    $result = [
        'command' => $command,
        'project' => getcwd() ?: '.',
        'provider' => 'auto',
        'apply' => false,
        'verify_providers' => false,
        'evolution_id' => null,
        'accept' => false,
    ];
    for ($index = $offset; $index < count($argv); $index++) {
        $argument = $argv[$index];
        if ($argument === '--apply') {
            $result['apply'] = true;
            continue;
        }
        if ($argument === '--verify-providers') {
            $result['verify_providers'] = true;
            continue;
        }
        if ($argument === '--accept') {
            $result['accept'] = true;
            continue;
        }
        if (str_starts_with($argument, '--evolution=')) {
            $result['evolution_id'] = substr($argument, strlen('--evolution='));
            continue;
        }
        if ($argument === '--evolution') {
            $result['evolution_id'] = $argv[++$index] ?? '';
            continue;
        }
        if (str_starts_with($argument, '--project=')) {
            $result['project'] = substr($argument, 10);
            continue;
        }
        if ($argument === '--project') {
            $result['project'] = $argv[++$index] ?? '';
            continue;
        }
        if (str_starts_with($argument, '--provider=')) {
            $result['provider'] = substr($argument, 11);
            continue;
        }
        if ($argument === '--provider') {
            $result['provider'] = $argv[++$index] ?? '';
            continue;
        }
        if (in_array($argument, ['--help', '-h'], true)) {
            echo "uso: bin/ralph-init plan|apply|evolve|rollback|uninstall|doctor --project <path> [--provider auto|codex|claude|opencode|hermes|agy] [--verify-providers] [--evolution EVL-YYYYMMDD-NNNN] [--accept] [--apply]\n";
            exit(0);
        }
        fail("argumento desconhecido: {$argument}", 2);
    }
    if (! in_array($result['command'], ['plan', 'apply', 'evolve', 'rollback', 'uninstall', 'doctor'], true)) {
        fail('comando inválido; use plan, apply, evolve, rollback, uninstall ou doctor', 2);
    }
    if (! in_array($result['provider'], ['auto', 'codex', 'claude', 'opencode', 'hermes', 'agy', 'cursor'], true)) {
        fail('provider inválido', 2);
    }

    return $result;
}

function projectRoot(string $path): string
{
    $root = realpath($path);
    if ($root === false || ! is_dir($root)) {
        fail("projeto não encontrado: {$path}", 2);
    }
    $command = 'git -C '.escapeshellarg($root).' rev-parse --show-toplevel 2>/dev/null';
    $gitRoot = trim((string) shell_exec($command));
    if ($gitRoot === '') {
        fail('o projeto precisa ser um checkout Git', 2);
    }

    return realpath($gitRoot) ?: $gitRoot;
}

/** @return array{exit: int, output: string, timed_out: bool} */
function commandResult(string $command, string $cwd, int $timeoutSeconds = 8): array
{
    $timeoutBinary = trim((string) shell_exec('command -v timeout 2>/dev/null'));
    $usesExternalTimeout = $timeoutBinary !== '';
    $runCommand = $usesExternalTimeout
        ? commandLine($timeoutBinary, ['--signal=TERM', '--kill-after=1s', $timeoutSeconds.'s', 'sh', '-c', $command])
        : $command;
    $process = proc_open($runCommand, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $cwd);
    if (! is_resource($process)) {
        return ['exit' => 1, 'output' => '', 'timed_out' => false];
    }
    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $output = '';
    $timedOut = false;
    $exitCodeFromStatus = null;
    $deadline = microtime(true) + $timeoutSeconds;
    while (true) {
        $status = proc_get_status($process);
        $output .= (string) stream_get_contents($pipes[1]).(string) stream_get_contents($pipes[2]);
        if (! ($status['running'] ?? false)) {
            $exitCodeFromStatus = is_int($status['exitcode'] ?? null) && ($status['exitcode'] ?? -1) >= 0
                ? $status['exitcode']
                : null;
            break;
        }
        if (! $usesExternalTimeout && microtime(true) >= $deadline) {
            proc_terminate($process, 15);
            usleep(100000);
            $terminatedStatus = proc_get_status($process);
            if ($terminatedStatus['running'] ?? false) {
                proc_terminate($process, 9);
            } elseif (is_int($terminatedStatus['exitcode'] ?? null) && ($terminatedStatus['exitcode'] ?? -1) >= 0) {
                $exitCodeFromStatus = $terminatedStatus['exitcode'];
            }
            $timedOut = true;
            break;
        }
        usleep(20000);
    }
    $output .= (string) stream_get_contents($pipes[1]).(string) stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $closeExit = proc_close($process);
    $exit = $exitCodeFromStatus ?? $closeExit;
    $timedOut = $timedOut || ($usesExternalTimeout && in_array($exit, [124, 137, 143], true)) || ($usesExternalTimeout && in_array($closeExit, [124, 137, 143], true));

    return ['exit' => $timedOut ? 124 : $exit, 'output' => trim($output), 'timed_out' => $timedOut];
}

function commandLine(string $path, array $arguments = []): string
{
    return escapeshellarg($path).($arguments === [] ? '' : ' '.implode(' ', array_map('escapeshellarg', $arguments)));
}

function sanitizeProviderText(string $output): string
{
    $line = trim((string) (preg_split('/\R/', $output, 2)[0] ?? ''));
    $redacted = preg_replace('/(token|api[_-]?key|secret|password|authorization|bearer)\s*[:=]\s*\S+/i', '[redacted]', $line);

    return substr($redacted === null ? '' : $redacted, 0, 160);
}

/** @return array<string, array<string, mixed>> */
function providerDefinitions(): array
{
    return [
        'codex' => [
            'auth' => ['args' => ['login', 'status'], 'classifier' => 'codex'],
            'health' => ['args' => ['doctor', '--json']],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'claude' => [
            'auth' => ['args' => ['auth', 'status', '--json']],
            'health' => ['args' => ['auth', 'status', '--json']],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'opencode' => [
            'auth' => ['args' => ['auth', 'list'], 'classifier' => 'opencode_credentials'],
            'health' => ['args' => ['models'], 'classifier' => 'opencode_models'],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'hermes' => [
            'auth' => ['args' => ['auth', 'status'], 'requires_env' => 'RALPH_HERMES_PROVIDER'],
            'health' => ['args' => ['status']],
            'runner_supported' => false,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'agy' => [
            'auth' => ['args' => ['models'], 'classifier' => 'agy_models'],
            'health' => ['args' => ['agents'], 'classifier' => 'agy_agents'],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
        'cursor' => [
            'auth' => ['args' => ['status', '--format', 'json'], 'classifier' => 'cursor_status'],
            'health' => ['args' => ['models'], 'classifier' => 'cursor_models'],
            'runner_supported' => true,
            'capabilities' => ['execution', 'model_selection', 'diagnostics'],
        ],
    ];
}

function stripAnsi(string $output): string
{
    $plain = preg_replace('/\x1B\[[0-?]*[ -\/]*[@-~]/', '', $output);

    return $plain === null ? $output : $plain;
}

function sanitizeProviderIdentifier(string $value): string
{
    $sanitized = preg_replace('/[^\p{L}\p{N} ._:+-]/u', '', trim($value));

    return substr(trim($sanitized === null ? '' : $sanitized), 0, 64);
}

function hasOpenCodeCredentialSignal(string $output): bool
{
    return preg_match('/^\s*[●•*]\s+.+\s+(?:api|oauth)\s*$/miu', stripAnsi($output)) === 1;
}

function hasOpenCodeModelSignal(string $output): bool
{
    return preg_match('/^\s*[a-z0-9][a-z0-9_.-]*\/[a-z0-9][a-z0-9_.-]*(?:\s|$)/mi', stripAnsi($output)) === 1;
}

function hasAgyModelSignal(string $output): bool
{
    return preg_match('/^\s*(?:gemini|claude|gpt)[A-Za-z0-9._-]+(?:\s|$)/mi', stripAnsi($output)) === 1;
}

function hasAgyAgentSignal(string $output): bool
{
    return preg_match('/^\s*[A-Za-z0-9._-]+(?:\s|$)/m', stripAnsi($output)) === 1;
}

function hasCursorStatusSignal(string $output): bool
{
    // Cursor é IDE com sessão local: o status --format json indica autenticação
    // quando contém conta/email/org (ou o equivalente da CLI), sem API key.
    return preg_match('/"(?:account|email|org|user|authenticated|active)"\s*:/i', stripAnsi($output)) === 1
        || preg_match('/logged\s+in|authenticated|active\s+account/i', stripAnsi($output)) === 1;
}

function hasCursorModelSignal(string $output): bool
{
    return preg_match('/^\s*[A-Za-z0-9][A-Za-z0-9._\/-]+(?:\s|$)/mi', stripAnsi($output)) === 1;
}

function extractHermesProvider(string $output): string
{
    if (preg_match('/^\s*Provider:\s*(\S.+?)\s*$/mi', stripAnsi($output), $matches) !== 1) {
        return '';
    }

    return sanitizeProviderIdentifier($matches[1]);
}

function hermesHealthPassed(array $result, string $providerTarget): bool
{
    if (($result['timed_out'] ?? false) === true || ($result['exit'] ?? 1) !== 0) {
        return false;
    }
    $output = stripAnsi((string) ($result['output'] ?? ''));
    $provider = extractHermesProvider($output);
    if ($provider === '' || strcasecmp($provider, $providerTarget) !== 0) {
        return false;
    }

    return preg_match('/^\s*Model:\s*\S.+?\s*$/mi', $output) === 1;
}

function hasUnauthenticatedSignal(string $output): bool
{
    return preg_match('/not[ _-]*(logged[ _-]*in|authenticated)|unauthenticated|authentication required|login required|no credentials|credential[s]? (missing|not configured)|invalid (token|credential)|token expired|expired credential|"(loggedIn|authenticated|valid|configured)"\s*:\s*false/i', $output) === 1;
}

function hasAuthenticatedSignal(string $output): bool
{
    return preg_match('/logged[ _-]+in|authenticated|"(loggedIn|authenticated|valid|configured)"\s*:\s*true|credentials?\s+(available|configured|valid)/i', $output) === 1;
}

function classifyAuth(array $result, string $classifier): string
{
    if (($result['timed_out'] ?? false) === true) {
        return 'unknown';
    }
    $output = (string) ($result['output'] ?? '');
    if ($classifier === 'opencode_credentials') {
        if (($result['exit'] ?? 1) !== 0) {
            return hasUnauthenticatedSignal($output) ? 'unauthenticated' : 'unknown';
        }
        if (hasOpenCodeCredentialSignal($output)) {
            return 'authenticated';
        }
        if (hasUnauthenticatedSignal($output)) {
            return 'unauthenticated';
        }

        return 'unknown';
    }
    if ($classifier === 'agy_models') {
        if (($result['exit'] ?? 1) !== 0) {
            return hasUnauthenticatedSignal($output) ? 'unauthenticated' : 'unknown';
        }

        return hasAgyModelSignal($output) ? 'authenticated' : 'unknown';
    }
    if ($classifier === 'cursor_status') {
        // Cursor é IDE com sessão local: sem API key. O status --format json
        // autenticado contém conta/sessão ativa; exit 0 + sinal = autenticado.
        if (($result['exit'] ?? 1) !== 0) {
            return hasUnauthenticatedSignal($output) ? 'unauthenticated' : 'unknown';
        }
        if (hasUnauthenticatedSignal($output)) {
            return 'unauthenticated';
        }

        return hasCursorStatusSignal($output) ? 'authenticated' : 'unknown';
    }
    if (hasUnauthenticatedSignal($output)) {
        return 'unauthenticated';
    }
    if (hasAuthenticatedSignal($output)) {
        return 'authenticated';
    }
    if (($result['exit'] ?? 1) !== 0) {
        return 'unknown';
    }
    if ($classifier === 'codex') {
        return 'authenticated';
    }

    return 'unknown';
}

function providerReason(string $status, string $authStatus, string $healthStatus, bool $verified, bool $runnerSupported = true): string
{
    if (! $verified) {
        return 'verificação explícita ainda não solicitada';
    }
    if ($status === 'functional') {
        return $runnerSupported
            ? 'autenticação e diagnóstico local não generativo aprovados'
            : 'CLI autenticada e saudável; adapter de execução ainda não está disponível';
    }
    if ($status === 'unsupported') {
        return 'provider não possui probe seguro registrado';
    }
    if ($authStatus === 'unauthenticated') {
        return 'sessão ou credencial não autenticada';
    }
    if ($authStatus !== 'authenticated') {
        return 'o diagnóstico não confirmou autenticação';
    }
    if ($healthStatus === 'unhealthy') {
        return 'diagnóstico local do provider falhou';
    }

    return 'funcionalidade não comprovada pelo probe seguro';
}

function healthPassed(string $classifier, array $result, ?string $providerTarget = null): bool
{
    if (($result['timed_out'] ?? false) === true || ($result['exit'] ?? 1) !== 0) {
        return false;
    }
    $output = (string) ($result['output'] ?? '');
    if ($classifier === 'opencode_models') {
        return hasOpenCodeModelSignal($output);
    }
    if ($classifier === 'agy_agents') {
        return hasAgyAgentSignal($output);
    }
    if ($classifier === 'cursor_status') {
        return hasCursorStatusSignal($output);
    }
    if ($classifier === 'cursor_models') {
        return hasCursorModelSignal($output);
    }
    if ($classifier === 'hermes_status') {
        return $providerTarget !== null && hermesHealthPassed($result, $providerTarget);
    }

    return ! hasUnauthenticatedSignal($output);
}

/** @return array<string, mixed> */
function verifyHermesProvider(string $path, string $root, array $definition, array $base): array
{
    $statusResult = commandResult(commandLine($path, $definition['health']['args']), $root);
    $providerTarget = sanitizeProviderIdentifier((string) getenv('RALPH_HERMES_PROVIDER'));
    if ($providerTarget === '') {
        $providerTarget = extractHermesProvider((string) ($statusResult['output'] ?? ''));
    }
    if ($providerTarget === '') {
        $base['status'] = 'authentication_unknown';
        $base['reason'] = 'provider alvo não informado e não foi identificado no diagnóstico Hermes';
        $base['verification']['health_exit'] = $statusResult['exit'];
        $base['verification']['health_timed_out'] = $statusResult['timed_out'];

        return $base;
    }

    $authArgs = $definition['auth']['args'];
    $authArgs[] = $providerTarget;
    $authResult = commandResult(commandLine($path, $authArgs), $root);
    $authStatus = classifyAuth($authResult, 'hermes');
    $base['auth_status'] = $authStatus;
    $base['verification']['provider_target'] = $providerTarget;
    $base['verification']['auth_exit'] = $authResult['exit'];
    $base['verification']['auth_timed_out'] = $authResult['timed_out'];
    if ($authStatus !== 'authenticated') {
        $base['status'] = $authStatus === 'unauthenticated' ? 'unauthenticated' : 'authentication_unknown';
        $base['reason'] = providerReason($base['status'], $authStatus, 'unsupported', true, $base['runner_supported']);

        return $base;
    }

    $healthStatus = healthPassed('hermes_status', $statusResult, $providerTarget) ? 'healthy' : 'unhealthy';
    $base['health_status'] = $healthStatus;
    $base['verification']['health_exit'] = $statusResult['exit'];
    $base['verification']['health_timed_out'] = $statusResult['timed_out'];
    $base['status'] = $healthStatus === 'healthy' ? 'functional' : 'degraded';
    $base['adapter_enabled'] = $base['status'] === 'functional' && $base['runner_supported'];
    $base['reason'] = providerReason($base['status'], $authStatus, $healthStatus, true, $base['runner_supported']);

    return $base;
}

/** @return array<string, mixed> */
function verifyProvider(string $provider, string $path, string $root): array
{
    $definition = providerDefinitions()[$provider] ?? null;
    $base = [
        'verification' => [
            'requested' => true,
            'mode' => 'safe',
            'probe_kind' => 'diagnostic',
            'checked_at' => gmdate('Y-m-d\\TH:i:s\\Z'),
        ],
        'auth_status' => 'unknown',
        'health_status' => 'unsupported',
        'status' => 'unsupported',
        'adapter_enabled' => false,
        'runner_supported' => (bool) ($definition['runner_supported'] ?? false),
        'capabilities' => $definition['capabilities'] ?? [],
    ];
    if ($definition === null || $definition['auth'] === null || $definition['health'] === null) {
        $base['reason'] = providerReason('unsupported', 'unknown', 'unsupported', true);
        return $base;
    }
    if ($provider === 'hermes') {
        return verifyHermesProvider($path, $root, $definition, $base);
    }
    $requiredEnv = $definition['auth']['requires_env'] ?? null;
    $providerTarget = $requiredEnv !== null ? trim((string) getenv($requiredEnv)) : '';
    if ($requiredEnv !== null && $providerTarget === '') {
        $base['auth_status'] = 'unknown';
        $base['status'] = 'authentication_unknown';
        $base['reason'] = 'provider alvo não informado em '.$requiredEnv;
        return $base;
    }
    $authArgs = $definition['auth']['args'];
    if ($providerTarget !== '') {
        $authArgs[] = $providerTarget;
    }
    $authResult = commandResult(commandLine($path, $authArgs), $root);
    $authStatus = classifyAuth($authResult, (string) ($definition['auth']['classifier'] ?? 'exit_zero'));
    $base['auth_status'] = $authStatus;
    $base['verification']['auth_exit'] = $authResult['exit'];
    $base['verification']['auth_timed_out'] = $authResult['timed_out'];
    if ($authStatus !== 'authenticated') {
        $base['status'] = $authStatus === 'unauthenticated' ? 'unauthenticated' : 'authentication_unknown';
        $base['reason'] = providerReason($base['status'], $authStatus, 'unsupported', true, $base['runner_supported']);
        return $base;
    }

    $healthArgs = $definition['health']['args'];
    if ($provider === 'agy') {
        $healthArgs = ['--add-dir', $root, 'agents'];
    }
    // O probe `models` do OpenCode cataloga o provider local e pode levar mais
    // de 8s (observado em 1.18.18: ~11s); timeout generoso evita falso
    // degraded que nunca habilitaria o adapter.
    $healthTimeout = $provider === 'opencode' ? 30 : 8;
    $healthResult = commandResult(commandLine($path, $healthArgs), $root, $healthTimeout);
    $healthClassifier = (string) ($definition['health']['classifier'] ?? 'exit_zero');
    $healthStatus = healthPassed($healthClassifier, $healthResult) ? 'healthy' : 'unhealthy';
    $base['health_status'] = $healthStatus;
    $base['verification']['health_exit'] = $healthResult['exit'];
    $base['verification']['health_timed_out'] = $healthResult['timed_out'];
    $base['status'] = $healthStatus === 'healthy' ? 'functional' : 'degraded';
    $base['adapter_enabled'] = $base['status'] === 'functional' && $base['runner_supported'];
    $base['reason'] = providerReason($base['status'], $authStatus, $healthStatus, true, $base['runner_supported']);

    if ($provider === 'agy' && $base['status'] === 'functional') {
        $home = rtrim((string) getenv('HOME'), '/');
        $tokenFile = trim((string) getenv('RALPH_AGY_TOKEN_FILE'));
        $tokenFile = $tokenFile !== '' ? $tokenFile : $home.'/.gemini/antigravity-cli/antigravity-oauth-token';
        $bwrap = trim((string) shell_exec('command -v bwrap 2>/dev/null'));
        $isolationReady = PHP_OS_FAMILY === 'Linux' && $bwrap !== '' && is_file($tokenFile) && is_readable($tokenFile);
        if ($isolationReady) {
            $smoke = commandResult(commandLine($bwrap, ['--ro-bind', '/', '/', '--proc', '/proc', '--dev', '/dev', '--unshare-pid', '--die-with-parent', '/bin/true']), $root, 5);
            $isolationReady = ($smoke['exit'] ?? 1) === 0 && ($smoke['timed_out'] ?? true) === false;
        }
        if (! $isolationReady) {
            $base['status'] = 'degraded';
            $base['adapter_enabled'] = false;
            $base['reason'] = 'CLI agy funcional, mas verify exige Linux, bwrap operacional e token OAuth legível';
        }
    }

    return $base;
}

/**
 * Domínio de falha do provider para a FEATURE-094 (Phase 3).
 *
 * O domínio é um rótulo opaco, sem segredos. Na v1 ele vem de um identificador
 * declarado no perfil do provider (`RALPH_<PROVIDER>_FAILURE_DOMAIN`); o
 * readiness só o considera `declared` — nunca `observed`/`exact` sem evidência
 * real de autoridade (credencial, endpoint e conta/projeto). Modelo e alias
 * nunca são usados para inferir o domínio.
 *
 * @return array{failure_domain: ?string, failure_domain_status: string, failure_domain_source: string}
 */
function providerFailureDomain(string $provider, string $root): array
{
    $profile = $root.'/.ralph/'.$provider.'.env';
    $label = null;
    if (is_file($profile)) {
        foreach (file($profile, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
            $upper = strtoupper($provider);
            if (str_starts_with($line, 'RALPH_'.$upper.'_FAILURE_DOMAIN=')) {
                $value = trim(substr($line, strlen('RALPH_'.$upper.'_FAILURE_DOMAIN=')), " \t\"");
                if ($value !== '') {
                    $label = $value;
                }
                break;
            }
        }
    }
    if ($label === null) {
        return [
            'failure_domain' => null,
            'failure_domain_status' => 'unavailable',
            'failure_domain_source' => 'not_exposed',
        ];
    }

    // Rótulo opaco: nunca persistimos o valor bruto; só um fingerprint.
    return [
        'failure_domain' => 'domain_'.substr(hash('sha256', $label), 0, 32),
        'failure_domain_status' => 'declared',
        'failure_domain_source' => 'profile_declared_label',
    ];
}

/** @return array<string, mixed> */
function detectProject(string $root, bool $verifyProviders = false): array
{
    $commands = ['codex', 'claude', 'opencode', 'hermes', 'agy', 'cursor'];
    $definitions = providerDefinitions();
    $providers = [];
    foreach ($commands as $command) {
        // A CLI Cursor pode ser `cursor-agent` ou `agent`; a identidade canônica
        // permanece `cursor`.
        $candidate = $command;
        if ($command === 'cursor') {
            if (trim((string) shell_exec('command -v cursor-agent 2>/dev/null')) !== '') {
                $candidate = 'cursor-agent';
            } else {
                $candidate = 'agent';
            }
        }
        $path = trim((string) shell_exec('command -v '.escapeshellarg($candidate).' 2>/dev/null'));
        $version = null;
        if ($path !== '') {
            $result = commandResult(commandLine($path, ['--version']), $root, 5);
            $version = $result['exit'] === 0 ? sanitizeProviderText($result['output']) : null;
        }
        $providers[$command] = [
            'installed' => $path !== '',
            'path' => $path !== '' ? $path : null,
            'version' => $version,
            'auth_status' => 'not_checked',
            'health_status' => 'not_checked',
            'status' => $path === '' ? 'unavailable' : 'detected',
            'adapter_enabled' => false,
            'runner_supported' => (bool) ($definitions[$command]['runner_supported'] ?? false),
            'capabilities' => $definitions[$command]['capabilities'] ?? [],
            'verification' => [
                'requested' => $verifyProviders,
                'mode' => $verifyProviders ? 'safe' : 'none',
                'probe_kind' => 'diagnostic',
                'checked_at' => null,
            ],
            'reason' => $path === '' ? 'executável não encontrado' : 'provider detectado; autenticação não verificada',
        ];
        if ($verifyProviders && $path !== '') {
            $providers[$command] = array_merge($providers[$command], verifyProvider($command, $path, $root));
        }
        // FEATURE-094 (Phase 3): readiness expõe o failure_domain opaco para
        // providers funcionais com adapter habilitado. Não é usado para
        // seleção nem para fallback; alimenta a decisão de failover no
        // controlador.
        if (($providers[$command]['adapter_enabled'] ?? false) === true) {
            $providers[$command] = array_merge($providers[$command], providerFailureDomain($command, $root));
        } else {
            $providers[$command] = array_merge($providers[$command], [
                'failure_domain' => null,
                'failure_domain_status' => 'unavailable',
                'failure_domain_source' => 'adapter_disabled',
            ]);
        }
    }

    $signals = [
        'codex' => is_dir($root.'/.codex') || is_dir($root.'/.codex-plugin'),
        'claude' => is_dir($root.'/.claude') || is_dir($root.'/.claude-plugin') || is_file($root.'/CLAUDE.md'),
        'opencode' => is_dir($root.'/.opencode') || is_file($root.'/opencode.json') || is_file($root.'/opencode.yaml') || is_file($root.'/opencode.toml'),
    ];
    $testCommand = null;
    if (is_file($root.'/bin/check')) {
        $testCommand = 'bin/check';
    } elseif (is_file($root.'/composer.json')) {
        $testCommand = 'composer test';
    } elseif (is_file($root.'/package.json')) {
        $testCommand = 'npm test';
    } elseif (is_file($root.'/pyproject.toml') || is_file($root.'/pytest.ini')) {
        $testCommand = 'pytest';
    } elseif (is_file($root.'/go.mod')) {
        $testCommand = 'go test ./...';
    } elseif (is_file($root.'/Cargo.toml')) {
        $testCommand = 'cargo test';
    }
    $git = [
        'commit' => trim((string) shell_exec('git -C '.escapeshellarg($root).' rev-parse HEAD 2>/dev/null')),
        'branch' => trim((string) shell_exec('git -C '.escapeshellarg($root).' branch --show-current 2>/dev/null')),
        'working_tree_clean' => trim((string) shell_exec('git -C '.escapeshellarg($root).' status --porcelain 2>/dev/null')) === '',
    ];

    return [
        'providers' => $providers,
        'verification' => [
            'requested' => $verifyProviders,
            'mode' => $verifyProviders ? 'safe' : 'none',
            'live_generation_probe' => false,
        ],
        'harness_signals' => $signals,
        'test_command' => $testCommand,
        'git' => $git,
        'context_files' => array_values(array_filter(['AGENTS.md', 'CLAUDE.md', 'docs/agents', '.spec'], static fn (string $path): bool => file_exists($root.'/'.$path))),
    ];
}

function selectProvider(array $detected, string $requested): ?string
{
    if ($requested !== 'auto') {
        if (! ($detected['providers'][$requested]['installed'] ?? false)) {
            fail("provider {$requested} não está instalado", 2);
        }

        return $requested;
    }
    foreach (providerOrder() as $candidate) {
        if (($detected['harness_signals'][$candidate] ?? false) && ($detected['providers'][$candidate]['adapter_enabled'] ?? false)) {
            return $candidate;
        }
    }
    foreach (providerOrder() as $candidate) {
        if ($detected['providers'][$candidate]['adapter_enabled'] ?? false) {
            return $candidate;
        }
    }

    return null;
}

/** @return list<string> */
function providerOrder(): array
{
    return ['codex', 'claude', 'opencode', 'hermes', 'agy', 'cursor'];
}

/** @return list<string> */
function providersWithStatus(array $detected, string $status): array
{
    return array_values(array_filter(
        providerOrder(),
        static fn (string $provider): bool => ($detected['providers'][$provider]['status'] ?? null) === $status
    ));
}

/** @return list<string> */
function availableRunners(array $detected): array
{
    return array_values(array_filter(
        providerOrder(),
        static fn (string $provider): bool => ($detected['providers'][$provider]['adapter_enabled'] ?? false) === true
    ));
}

function providerAdapterEnabled(array $detected, ?string $provider): bool
{
    return $provider !== null && ($detected['providers'][$provider]['adapter_enabled'] ?? false) === true;
}

function hashFile(string $path): ?string
{
    return is_file($path) ? hash_file('sha256', $path) ?: null : null;
}

function entryType(string $path): ?string
{
    if (is_link($path)) {
        return 'symlink';
    }
    if (is_file($path)) {
        return 'file';
    }
    if (is_dir($path)) {
        return 'directory';
    }

    return null;
}

function entryMode(string $path): ?string
{
    $stat = @lstat($path);
    if (! is_array($stat) || ! isset($stat['mode'])) {
        return null;
    }

    return sprintf('%04o', ((int) $stat['mode']) & 07777);
}

function entryHash(string $path, ?string $type = null): ?string
{
    $type ??= entryType($path);
    if ($type === 'file') {
        return hashFile($path);
    }
    if ($type === 'symlink') {
        $target = readlink($path);
        return $target === false ? null : hash('sha256', $target);
    }
    if ($type === 'directory') {
        return hash('sha256', 'directory');
    }

    return null;
}

function entryLinkTarget(string $path, ?string $type = null): ?string
{
    return ($type ?? entryType($path)) === 'symlink' ? (readlink($path) ?: null) : null;
}

function entryExists(string $path): bool
{
    return file_exists($path) || is_link($path);
}

function entryMatches(string $path, array $member): bool
{
    $type = entryType($path);
    if ($type !== ($member['type'] ?? null)) {
        return false;
    }
    if (entryMode($path) !== ($member['mode'] ?? null)) {
        return false;
    }
    if (entryHash($path, $type) !== ($member['sha256'] ?? null)) {
        return false;
    }
    if ($type === 'symlink' && entryLinkTarget($path, $type) !== ($member['link_target'] ?? null)) {
        return false;
    }

    return true;
}

/** @param list<array<string, mixed>> $members */
function legacyTreeFingerprint(array $members, ?string $rootMode = null): string
{
    usort($members, static fn (array $left, array $right): int => strcmp((string) ($left['relative_path'] ?? ''), (string) ($right['relative_path'] ?? '')));

    return hash('sha256', (string) $rootMode."\n".implode("\n", array_map(
        static fn (array $member): string => implode("\0", [
            (string) ($member['relative_path'] ?? ''),
            (string) ($member['type'] ?? ''),
            (string) ($member['mode'] ?? ''),
            (string) ($member['sha256'] ?? ''),
            (string) ($member['link_target'] ?? ''),
        ]),
        $members
    )));
}

/** @param list<array<string, mixed>> $members */
function orderedLegacyMembers(array $members, bool $restore = false): array
{
    usort($members, static function (array $left, array $right) use ($restore): int {
        $leftType = ($left['type'] ?? null) === 'directory' ? 1 : 0;
        $rightType = ($right['type'] ?? null) === 'directory' ? 1 : 0;
        if ($leftType !== $rightType) {
            return $restore ? $rightType <=> $leftType : $leftType <=> $rightType;
        }
        $leftDepth = substr_count((string) ($left['relative_path'] ?? ''), '/');
        $rightDepth = substr_count((string) ($right['relative_path'] ?? ''), '/');
        if ($leftDepth !== $rightDepth) {
            return $restore ? $leftDepth <=> $rightDepth : $rightDepth <=> $leftDepth;
        }

        return strcmp((string) ($left['relative_path'] ?? ''), (string) ($right['relative_path'] ?? ''));
    });

    return $members;
}

function isSafeRelativePath(string $path): bool
{
    if ($path === '' || str_starts_with($path, '/') || str_contains($path, "\\") || str_contains($path, "\0")) {
        return false;
    }
    foreach (explode('/', $path) as $segment) {
        if ($segment === '' || $segment === '.' || $segment === '..') {
            return false;
        }
    }

    return true;
}

function pathWithin(string $path, string $root): bool
{
    $resolvedPath = realpath($path);
    $resolvedRoot = realpath($root);
    if ($resolvedPath === false || $resolvedRoot === false) {
        return false;
    }

    return $resolvedPath === $resolvedRoot || str_starts_with($resolvedPath, $resolvedRoot.'/');
}

/** @return array{members: list<array<string, mixed>>, root_mode: ?string, error: ?string} */
function enumerateLegacyTree(string $projectRoot, string $absoluteRoot, string $relativeRoot, bool $rejectExternalSymlinks): array
{
    if (! isSafeRelativePath($relativeRoot) || ! is_dir($absoluteRoot) || is_link($absoluteRoot)) {
        return ['members' => [], 'root_mode' => null, 'error' => 'raiz legada inválida'];
    }
    $rootMode = entryMode($absoluteRoot);
    if ($rootMode === null) {
        return ['members' => [], 'root_mode' => null, 'error' => 'não foi possível ler as permissões da raiz legada'];
    }
    $members = [];
    try {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($absoluteRoot, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($iterator as $entry) {
            $absolute = $entry->getPathname();
            $memberRelativePath = str_replace(DIRECTORY_SEPARATOR, '/', substr($absolute, strlen($absoluteRoot) + 1));
            $memberPath = $relativeRoot.'/'.$memberRelativePath;
            if (! isSafeRelativePath($memberPath) || ! isSafeRelativePath($memberRelativePath)) {
                return ['members' => [], 'root_mode' => $rootMode, 'error' => 'membro legado com caminho absoluto ou traversal'];
            }
            if ($entry->isLink()) {
                if ($rejectExternalSymlinks) {
                    $target = realpath($absolute);
                    if ($target === false || ! pathWithin($target, $projectRoot)) {
                        return ['members' => [], 'root_mode' => $rootMode, 'error' => 'symlink legado aponta para fora da raiz do projeto'];
                    }
                }
                $type = 'symlink';
            } elseif ($entry->isDir()) {
                $type = 'directory';
            } elseif ($entry->isFile()) {
                $type = 'file';
            } else {
                return ['members' => [], 'root_mode' => $rootMode, 'error' => 'membro legado com tipo não suportado'];
            }
            $mode = entryMode($absolute);
            $sha256 = entryHash($absolute, $type);
            if ($mode === null || $sha256 === null) {
                return ['members' => [], 'root_mode' => $rootMode, 'error' => 'não foi possível calcular os metadados do membro legado'];
            }
            $member = [
                'path' => $memberPath,
                'relative_path' => $memberRelativePath,
                'type' => $type,
                'mode' => $mode,
                'sha256' => $sha256,
            ];
            if ($type === 'symlink') {
                $member['link_target'] = entryLinkTarget($absolute, $type);
            }
            $members[] = $member;
        }
    } catch (UnexpectedValueException|RuntimeException) {
        return ['members' => [], 'root_mode' => $rootMode, 'error' => 'não foi possível enumerar a árvore legada'];
    }

    usort($members, static fn (array $left, array $right): int => strcmp((string) $left['relative_path'], (string) $right['relative_path']));

    return ['members' => $members, 'root_mode' => $rootMode, 'error' => null];
}

/** @return list<array{path: string, type: string}> */
function approvedLegacyRoots(): array
{
    return [
        ['path' => 'harness/ralph', 'type' => 'legacy_directory'],
    ];
}

/** @return array<string, mixed> */
function inspectLegacyRoot(string $projectRoot, string $relativeRoot, string $type): array
{
    if (! isSafeRelativePath($relativeRoot)) {
        return [
            'path' => $relativeRoot,
            'type' => $type,
            'status' => 'rejected',
            'reason' => 'raiz legada fora do formato relativo permitido',
        ];
    }

    $root = $projectRoot.'/'.$relativeRoot;
    if (! file_exists($root) && ! is_link($root)) {
        return ['status' => 'absent'];
    }
    if (is_link($root) || ! is_dir($root) || ! pathWithin($root, $projectRoot)) {
        return [
            'path' => $relativeRoot,
            'type' => $type,
            'status' => 'rejected',
            'reason' => 'raiz legada inválida ou symlink fora do projeto',
        ];
    }

    $inventory = enumerateLegacyTree($projectRoot, $root, $relativeRoot, true);
    if ($inventory['error'] !== null) {
        return [
            'path' => $relativeRoot,
            'type' => $type,
            'status' => 'rejected',
            'reason' => $inventory['error'],
        ];
    }
    $members = $inventory['members'];
    $rootMode = $inventory['root_mode'];
    $memberNames = array_fill_keys(array_map(static fn (array $member): string => $member['relative_path'], $members), true);
    $requiredMembers = ['install.sh', 'ralph.patch', 'ralph.sh.upstream'];
    $matchingMembers = array_values(array_intersect($requiredMembers, array_keys($memberNames)));
    $candidate = $members !== [];
    if (! $candidate) {
        return ['status' => 'absent'];
    }

    if (count($matchingMembers) !== count($requiredMembers)) {
        return [
            'path' => $relativeRoot,
            'type' => $type,
            'status' => 'candidate',
            'reason' => 'raiz aprovada contém arquivos, mas não a composição legada completa',
        ];
    }

    $signatureId = 'bc_harness_legacy_directory_v1';

    return [
        'path' => $relativeRoot,
        'type' => $type,
        'status' => 'detected',
        'family' => 'bc-harness',
        'signature_id' => $signatureId,
        'members' => $members,
        'root_mode' => $rootMode,
        'tree_fingerprint' => legacyTreeFingerprint($members, $rootMode),
        'reason' => 'composição install.sh + ralph.patch + ralph.sh.upstream reconhecida',
    ];
}

/** @return array{installations: list<array<string, mixed>>, candidates: list<array<string, mixed>>} */
function detectLegacyInstallations(string $projectRoot): array
{
    $installations = [];
    $candidates = [];
    foreach (approvedLegacyRoots() as $definition) {
        $inspection = inspectLegacyRoot($projectRoot, $definition['path'], $definition['type']);
        if (($inspection['status'] ?? null) === 'detected') {
            $installations[] = $inspection;
            $candidates[] = [
                'path' => $inspection['path'],
                'type' => $inspection['type'],
                'status' => 'detected',
                'signature_id' => $inspection['signature_id'],
            ];
        } elseif (in_array($inspection['status'] ?? null, ['candidate', 'rejected'], true)) {
            $candidates[] = $inspection;
        }
    }

    return ['installations' => $installations, 'candidates' => $candidates];
}

/**
 * @param array<string, mixed>|null $methodManifest
 * @return array<string, mixed>
 */
function detectExistingRalphInstallation(string $root, ?array $methodManifest): array
{
    $manifestPath = '.ralph/install-manifest.json';
    $manifestPresent = is_file($root.'/'.$manifestPath);
    $methodStatus = $manifestPresent
        ? ($methodManifest === null ? 'invalid' : 'managed')
        : 'not_installed';
    $managedPaths = [];
    foreach (($methodManifest['managed_files'] ?? []) as $managed) {
        if (is_array($managed) && is_string($managed['path'] ?? null)) {
            $managedPaths[(string) $managed['path']] = true;
        }
    }

    $definitions = [
        ['id' => 'root_ralph_script', 'path' => 'ralph.sh', 'kind' => 'canonical_script'],
        ['id' => 'hidden_ralph_script', 'path' => '.ralph/ralph.sh', 'kind' => 'canonical_script'],
        ['id' => 'ralphfile', 'path' => 'Ralphfile', 'kind' => 'canonical_manifest'],
        ['id' => 'root_ralph_yaml', 'path' => 'ralph.yml', 'kind' => 'configuration'],
        ['id' => 'root_ralph_yaml_long', 'path' => 'ralph.yaml', 'kind' => 'configuration'],
        ['id' => 'root_ralph_json', 'path' => 'ralph.json', 'kind' => 'configuration'],
        ['id' => 'root_ralph_toml', 'path' => 'ralph.toml', 'kind' => 'configuration'],
        ['id' => 'hidden_ralph_yaml', 'path' => '.ralph.yml', 'kind' => 'configuration'],
        ['id' => 'hidden_ralph_yaml_long', 'path' => '.ralph.yaml', 'kind' => 'configuration'],
        ['id' => 'hidden_ralph_json', 'path' => '.ralph.json', 'kind' => 'configuration'],
        ['id' => 'hidden_ralph_toml', 'path' => '.ralph.toml', 'kind' => 'configuration'],
        ['id' => 'ralph_control_binary', 'path' => 'bin/ralph-control', 'kind' => 'canonical_binary'],
        ['id' => 'ralph_block_binary', 'path' => 'bin/ralph-block', 'kind' => 'canonical_binary'],
        ['id' => 'ralph_loop_script', 'path' => 'scripts/ralph.sh', 'kind' => 'canonical_script'],
        ['id' => 'ralph_install_manifest', 'path' => '.ralph/install-manifest.json', 'kind' => 'installation_manifest'],
        ['id' => 'ralph_ledger_events', 'path' => '.git/ralph-control/events.jsonl', 'kind' => 'runtime_ledger'],
        ['id' => 'ralph_workflow_state', 'path' => '.git/ralph-control/workflow.json', 'kind' => 'runtime_state'],
    ];
    $definedPaths = array_fill_keys(array_map(
        static fn (array $definition): string => (string) $definition['path'],
        $definitions
    ), true);
    foreach (array_merge(managedSources(), generatedPaths()) as $relative) {
        if (isset($definedPaths[$relative])) {
            continue;
        }
        $definitions[] = [
            'id' => 'ralph_method_surface:'.$relative,
            'path' => $relative,
            'kind' => str_starts_with($relative, '.ralph/')
                ? 'method_generated_file'
                : 'canonical_method_file',
        ];
        $definedPaths[$relative] = true;
    }
    $signals = [];
    $methodRuntimePaths = ['.git/ralph-control/events.jsonl', '.git/ralph-control/workflow.json'];
    foreach ($definitions as $definition) {
        $relative = $definition['path'];
        if (($managedPaths[$relative] ?? false) === true
            || ($methodStatus === 'managed' && ($relative === $manifestPath || in_array($relative, $methodRuntimePaths, true)))) {
            continue;
        }
        $absolute = $root.'/'.$relative;
        if (! is_file($absolute)) {
            continue;
        }
        $signals[] = [
            'id' => $definition['id'],
            'path' => $relative,
            'kind' => $definition['kind'],
            'sha256' => hashFile($absolute),
        ];
    }

    $strongSignals = array_values(array_filter(
        $signals,
        static fn (array $signal): bool => in_array($signal['id'], [
            'root_ralph_script', 'hidden_ralph_script', 'ralphfile',
            'ralph_control_binary', 'ralph_block_binary', 'ralph_loop_script',
            'ralph_install_manifest',
        ], true)
    ));
    $legacyDetection = detectLegacyInstallations($root);
    $legacyInstallation = $legacyDetection['installations'][0] ?? null;
    if ($legacyInstallation !== null) {
        $signals[] = [
            'id' => 'legacy_directory_root',
            'path' => $legacyInstallation['path'],
            'kind' => 'legacy_directory',
            'sha256' => $legacyInstallation['tree_fingerprint'],
        ];
    }
    $hasExternalSignals = $signals !== [];
    if ($legacyInstallation !== null) {
        $status = 'detected';
        $classification = 'external_ralph_legacy';
        $confidence = 'high';
        $recommendedAction = 'evolve';
        $reason = 'foi reconhecida uma instalação legada bc-harness em uma raiz aprovada';
    } elseif (! $hasExternalSignals) {
        $status = 'not_found';
        $classification = 'none';
        $confidence = 'none';
        $recommendedAction = 'proceed';
        $reason = $methodStatus === 'managed'
            ? 'manifesto válido do Ralph Method; sinais pertencentes ao método foram ignorados'
            : 'nenhum sinal de uma instalação Ralph externa foi encontrado';
    } elseif ($strongSignals !== [] || count($signals) >= 2) {
        $status = 'detected';
        $classification = 'external_ralph';
        $confidence = 'high';
        $recommendedAction = 'review_before_apply';
        $reason = 'foram encontrados sinais canônicos de Ralph fora do ownership do Ralph Method';
    } else {
        $status = 'ambiguous';
        $classification = 'unknown_ralph_like';
        $confidence = 'medium';
        $recommendedAction = 'review_before_apply';
        $reason = 'foi encontrado um sinal compatível, mas insuficiente para classificar a implementação';
    }

    return [
        'schema_version' => RALPH_INSTALL_DETECTION_SCHEMA_VERSION,
        'method' => [
            'status' => $methodStatus,
            'manifest_present' => $manifestPresent,
            'manifest_path' => $manifestPresent ? $manifestPath : null,
            'method_version' => $methodManifest['method_version'] ?? null,
        ],
        'external' => [
            'status' => $status,
            'classification' => $classification,
            'confidence' => $confidence,
            'signals' => $signals,
            'recommended_action' => $recommendedAction,
            'apply_allowed' => $status === 'not_found',
            'migration_supported' => false,
            'reason' => $reason,
            'family' => $legacyInstallation['family'] ?? null,
            'signature_id' => $legacyInstallation['signature_id'] ?? null,
            'legacy_root' => $legacyInstallation['path'] ?? null,
            'legacy_type' => $legacyInstallation['type'] ?? null,
            'members' => $legacyInstallation['members'] ?? [],
            'root_mode' => $legacyInstallation['root_mode'] ?? null,
            'tree_fingerprint' => $legacyInstallation['tree_fingerprint'] ?? null,
            'legacy_candidates' => $legacyDetection['candidates'],
        ],
    ];
}

function writeJson(string $path, array $value): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        fail("não foi possível criar {$directory}");
    }
    $temporary = $path.'.tmp.'.bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
    if (file_put_contents($temporary, $json, LOCK_EX) === false || ! rename($temporary, $path)) {
        @unlink($temporary);
        fail("não foi possível escrever {$path}");
    }
}

function writeJsonStrict(string $path, array $value): void
{
    $directory = dirname($path);
    if (! is_dir($directory) && ! mkdir($directory, 0700, true) && ! is_dir($directory)) {
        throw new RuntimeException("não foi possível criar {$directory}");
    }
    $temporary = $path.'.tmp.'.bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR)."\n";
    if (file_put_contents($temporary, $json, LOCK_EX) === false || ! rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException("não foi possível escrever {$path}");
    }
}

